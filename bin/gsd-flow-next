#!/usr/bin/env bash
#
# gsd-flow-next — which phase-flow step comes next, read from the phase folder.
#
# The step engine behind the /gsd-flow skill. Looks at .planning/phases/<P>-*/
# in the checkout you are standing in (a phase worktree) and prints the FIRST
# step whose artifact is missing, in the agreed order. It runs nothing: the
# skill (or you) runs the printed command, then calls this again. Because it
# reads artifacts, it is resumable — after a crash or a /clear it simply says
# where you are. The same artifact list drives the guard's `flow = strict`
# rule and a repo's pre-merge gate, so what this considers done, they accept.
#
# Order:
#   story        <P>-STORY.md (or cu_<id> in the dir name)  — ClickUp story
#   discuss      <P>-CONTEXT.md                             /gsd-discuss-phase
#   ui-decision  no UI-SPEC and no PLAN yet → the skill asks "screens?"
#   ui-phase     <P>-UI-SPEC.md (screens only)              /gsd-ui-phase
#   plan         a <P>-NN-PLAN.md                           /gsd-plan-phase
#   review       <P>-REVIEWS.md                             /gsd-review --codex
#                                                           + /gsd-plan-phase --reviews
#   replan       a PLAN committed after REVIEWS.md            /gsd-plan-phase --reviews
#   execute      a SUMMARY for every PLAN                   /gsd-execute-phase
#   verifier     <P>-VERIFICATION.md exists                  (execute-phase re-run)
#   gaps         <P>-VERIFICATION.md status gaps_found      --gaps / --gaps-only
#   verify-work  a <P>-*UAT.md not pending/partial          /gsd-verify-work
#   code-review  <P>-REVIEW.md; not clean → <P>-REVIEW-FIX  /gsd-code-review [--fix]
#   ui-review    <P>-UI-REVIEW.md (screens only)            /gsd-ui-review
#   secure       <P>-SECURITY.md, threats_open: 0           /gsd-secure-phase
#   done         → gsd-finish
#
# Usage:
#   gsd-flow-next [<N>] [--repo <dir>] [--no-ui] [--all] [--json]
#     <N>       phase number; default: from the current phase-<N>-* branch
#     --no-ui   this phase has no screens (skips ui-decision/ui-phase/ui-review)
#     --ui      this phase has screens (settles ui-decision without a UI-SPEC)
#     --all     print every remaining step, not just the next one
#     --json    one JSON object per step
#
# Output (text): key=value lines — step, run, then (optional second command),
# stop (why the skill must pause for the user after this step), note.
set -uo pipefail

usage() { awk 'NR>1 && /^set -uo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"; }
N=""; REPO=""; UI=""; ALL=0; JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="$2"; shift ;;
    --no-ui) UI=no ;; --ui) UI=yes ;;
    --all) ALL=1 ;; --json) JSON=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 64 ;;
    *) N="$1" ;;
  esac
  shift
done
REPO="${REPO:-$PWD}"
if [ -z "$N" ]; then
  br=$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  case "$br" in phase-*) N=$(printf '%s' "$br" | sed -E 's/^phase-([0-9]+(\.[0-9]+)?).*/\1/') ;; esac
  [ -n "$N" ] || { echo "no phase number given and '$br' is not a phase-<N>-* branch" >&2; exit 64; }
fi
case "$N" in *.*) P="$N" ;; *) P=$(printf '%02d' "$N") ;; esac
pd=""; for d in "$REPO/.planning/phases/$P"-*; do [ -d "$d" ] && { pd="$d"; break; }; done
[ -n "$pd" ] || { echo "no .planning/phases/$P-* directory in $REPO" >&2; exit 1; }

has() { [ -f "$pd/$P-$1" ]; }
fm()  { sed -n '/^---$/,/^---$/p' "$pd/$P-$1" 2>/dev/null | sed -n -E "s/^$2:[[:space:]]*//p" | head -1 | tr -d '[:space:]'; }
jstr() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

EMITTED=0
emit() {  # $1=step $2=run $3=then $4=stop $5=note
  EMITTED=$((EMITTED + 1))
  if [ "$JSON" = 1 ]; then
    printf '{"phase":"%s","step":"%s","run":"%s","then":"%s","stop":"%s","note":"%s"}\n' \
      "$N" "$1" "$(jstr "$2")" "$(jstr "$3")" "$(jstr "$4")" "$(jstr "$5")"
  else
    [ "$EMITTED" -gt 1 ] && echo "--"
    printf 'step=%s\n' "$1"
    [ -n "$2" ] && printf 'run=%s\n' "$2"
    [ -n "$3" ] && printf 'then=%s\n' "$3"
    [ -n "$4" ] && printf 'stop=%s\n' "$4"
    [ -n "$5" ] && printf 'note=%s\n' "$5"
  fi
  [ "$ALL" = 1 ] || exit 0
}

# screens? UI-SPEC on disk settles it; otherwise the caller's --ui/--no-ui.
if has UI-SPEC.md; then UI=yes; fi

# 1 story
if ! has STORY.md; then
  case "$pd" in *cu_*) ;; *) emit story "create the ClickUp story (product words, no tech), then snapshot it as $P-STORY.md" "" "the story needs the user's product intent" "gsd-start --cu <id> writes the snapshot; if the phase was claimed without --cu, write $P-STORY.md by hand" ;; esac
fi
# 2 discuss
has CONTEXT.md || emit discuss "/gsd-discuss-phase $N" "update the ClickUp story to the agreed scope" "discuss asks the user the open questions" "run it live — never auto-answer"
# 3 screens?
PLANS=$(ls "$pd/$P"-[0-9]*-PLAN.md 2>/dev/null || true)
if [ -z "$UI" ] && [ -z "$PLANS" ]; then
  emit ui-decision "" "" "ask the user: does phase $N have screens? then re-run with --ui or --no-ui" "UI is agreed BEFORE planning; plan-phase would otherwise auto-generate an un-agreed UI-SPEC"
fi
# 4 ui-phase
if [ "$UI" = yes ] && ! has UI-SPEC.md; then
  emit ui-phase "/gsd-ui-phase $N" "" "the user must agree the screens before planning" ""
fi
# 5 plan
[ -n "$PLANS" ] || emit plan "/gsd-plan-phase $N" "" "" ""
# 6 cross-AI review
has REVIEWS.md || emit review "/gsd-review --phase $N --codex" "/gsd-plan-phase $N --reviews" "show the user the codex findings before the replan; verify each against the plans, never accept on trust" "key: OPENAI_API_KEY from ~/.config/ai-keys/keys.env"
# 6b replan — the --reviews replan leaves no artifact of its own, so use git:
# a plan committed after REVIEWS.md means it happened (commit_docs is on in a
# GSD repo). Same commit counts as done; REVIEWS.md uncommitted = not yet.
if has REVIEWS.md && [ -n "$PLANS" ]; then
  rt=$(git -C "$REPO" log -1 --format=%ct -- "$pd/$P-REVIEWS.md" 2>/dev/null || true)
  pt=0; for f in $PLANS; do t=$(git -C "$REPO" log -1 --format=%ct -- "$f" 2>/dev/null || true); [ "${t:-0}" -gt "$pt" ] && pt="$t"; done
  if [ -z "$rt" ] || [ "$pt" -lt "$rt" ]; then
    emit replan "/gsd-plan-phase $N --reviews" "" "" "REVIEWS.md exists but no plan was committed after it — the review was not folded into the plans"
  fi
fi
# 7 execute
MISSING=0; for f in $PLANS; do [ -f "${f%-PLAN.md}-SUMMARY.md" ] || MISSING=$((MISSING + 1)); done
[ "$MISSING" -eq 0 ] || emit execute "/gsd-execute-phase $N" "" "" "$MISSING plan(s) without a SUMMARY; execute-phase runs code review and the verifier itself"
# 7b verifier — all plans done but the verifier never wrote its report
if [ -n "$PLANS" ] && [ "$MISSING" -eq 0 ] && ! has VERIFICATION.md; then
  emit verifier "/gsd-execute-phase $N" "" "" "every plan has a SUMMARY but there is no VERIFICATION.md; with all plans complete, execute-phase only runs the verifier"
fi
# 8 gaps
if [ "$(fm VERIFICATION.md status)" = "gaps_found" ]; then
  emit gaps "/gsd-plan-phase $N --gaps" "/gsd-execute-phase $N --gaps-only" "" "VERIFICATION.md reports gaps"
fi
# 9 verify-work
UATS=$(ls "$pd/$P"-*UAT.md 2>/dev/null || true); OPEN=""
for u in $UATS; do st=$(sed -n '/^---$/,/^---$/p' "$u" | sed -n -E 's/^status:[[:space:]]*//p' | head -1 | tr -d '[:space:]'); case "$st" in pending|partial) OPEN="$OPEN $(basename "$u")($st)";; esac; done
if [ -z "$UATS" ]; then emit verify-work "/gsd-verify-work $N" "" "" "agent-driven UAT walk (Playwright/screenshots), recorded as agent-verified"
elif [ -n "$OPEN" ]; then emit verify-work "/gsd-verify-work $N" "" "" "open UAT items:$OPEN"; fi
# 10 code review
if ! has REVIEW.md; then emit code-review "/gsd-code-review $N" "" "" "execute-phase normally produces this; missing means it errored"
else
  st=$(fm REVIEW.md status)
  case "$st" in ""|clean|skipped) ;; *) has REVIEW-FIX.md || emit code-review "/gsd-code-review $N --fix" "" "" "REVIEW.md status: $st" ;; esac
fi
# 11 ui-review
if [ "$UI" = yes ] && ! has UI-REVIEW.md; then emit ui-review "/gsd-ui-review $N" "" "" "phase has screens"; fi
# 12 secure — the last code gate
if ! has SECURITY.md; then emit secure "/gsd-secure-phase $N" "" "" "last code gate — after every --fix has landed"
else open=$(fm SECURITY.md threats_open); [ "${open:-0}" = 0 ] || emit secure "/gsd-secure-phase $N" "" "" "$open open threat(s)"; fi

emit "done" "gsd-finish" "" "gsd-finish deletes the worktree the session is standing in — it must be the LAST action" "optional before finishing: /gsd-validate-phase $N"
