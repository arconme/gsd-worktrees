#!/usr/bin/env bash
#
# gsd-init — take a repo with NO GSD to "ready for gsd-start" in one command:
# installs the worktree workflow (gsd-bootstrap-repo), then prints (or, with
# --launch, opens) the right initialization prompt. Provider adapters choose
# the actual CLI argv; print-only is the default.
set -euo pipefail

die() { printf '✖ %s\n' "$@" >&2; exit 1; }

usage() {
  cat <<'HELP'
gsd-init — set up GSD in a repo that doesn't have it yet

Runs gsd-bootstrap-repo (shared scripts/config/instructions plus the selected
provider adapter) and then prints or opens the initialization session.

  /gsd-new-project    when the repo has no planning docs (fresh interview)
  /gsd-ingest-docs    when ADRs/PRDs/SPECs are detected (bootstrap from them)

The initialization itself stays interactive — that conversation is where the
project context comes from; gsd-init removes every step around it.

Safe to re-run: if the repo is already initialized (.planning/ROADMAP.md
exists), the workflow files are still repaired/synced from the source, but the
planning state is never touched — you're just pointed back to gsd-start.

USAGE
  gsd-init [options]          # run from INSIDE the target repo

OPTIONS
  --new            force /gsd-new-project (skip docs detection)
  --ingest         force /gsd-ingest-docs
  --src <path>     deprecated compatibility flag; bootstrap ignores it
  --base <branch>  base branch override (passed to gsd-bootstrap-repo)
  --no-commit      don't commit the bootstrap files (default: commit)
  --no-ui          the project has no screens (backend, CLI): ui_gates = off
  --providers <list> comma-separated integrations to install, in default order
  --provider <p>   provider for the initialization session; when --providers
                   is omitted, also selects the single integration to install
  --provider-command <p=path> executable override for one provider; repeatable
  --agent-command <path> executable override (implies --launch; add --no-launch to print)
  --model <id>     session model override; 'default' uses the CLI's own default
  --agent <value>  compatibility alias: provider or custom executable;
                   naming one implies --launch
  --launch         open the session with the default agent (default is NO
                   launch — the 'cd … && <agent> …' command is printed instead)
  --no-launch      force print-only, overriding --agent/--launch
  -h, --help       show this help

EXAMPLES
  cd ~/projects/acme/webshop && gsd-init
      Bootstrap + commit, then print the configured init command.

  cd ~/projects/acme/webshop && gsd-init --launch
      Same, but open the configured session right away.

  gsd-init --ingest --agent gemini
      Force ingest mode and open the session with the gemini CLI.

  gsd-init --providers claude,codex,gemini --provider codex --no-launch
      Install all three integrations and print the Codex initialization command.

  gsd-init --providers claude,codex --provider-command codex=/opt/bin/codex
      Install Claude and Codex integrations with an explicit Codex executable.

  gsd-init --base main
      Bootstrap against 'main', print the init command to run later.

AFTER INITIALIZATION
  gsd-start -n "<description>"   begin each feature (claim + worktree + session)
  gsd-finish                  land it (merge back, push, clean up)

RELATED
  gsd-bootstrap-repo   just the file installation (what gsd-init wraps)
  gsd-start, gsd-finish
HELP
}

MODE=""          # "" = auto-detect | new | ingest
BOOT_ARGS=()
COMMIT=1
PROVIDER_CLI=""
PROVIDERS_CLI=""
PROVIDER_COMMAND_ARGS=()
PROVIDER_COMMAND_COUNT=0
AGENT_COMMAND_CLI=""
MODEL_CLI=""
LAUNCH=0
FORCE_NOLAUNCH=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --new)    MODE=new;    shift ;;
    --ingest) MODE=ingest; shift ;;
    --src)  [ $# -ge 2 ] || die "--src needs a value";  BOOT_ARGS+=(--src "$2");  shift 2 ;;
    --base) [ $# -ge 2 ] || die "--base needs a value"; BOOT_ARGS+=(--base "$2"); shift 2 ;;
    --no-commit) COMMIT=0; shift ;;
    --no-ui) BOOT_ARGS+=(--no-ui); shift ;;
    --providers) [ $# -ge 2 ] || die "--providers needs a comma-separated list"; PROVIDERS_CLI="$2"; shift 2 ;;
    --provider) [ $# -ge 2 ] || die "--provider needs claude, codex, gemini, or custom"; PROVIDER_CLI="$2"; shift 2 ;;
    --model) [ $# -ge 2 ] && [ -n "$2" ] || die "--model needs a model ID or default"; MODEL_CLI="$2"; shift 2 ;;
    --provider-command) [ $# -ge 2 ] || die "--provider-command needs provider=executable"; PROVIDER_COMMAND_ARGS+=("$2"); PROVIDER_COMMAND_COUNT=$((PROVIDER_COMMAND_COUNT+1)); shift 2 ;;
    --agent-command) [ $# -ge 2 ] || die "--agent-command needs one executable path/name"; AGENT_COMMAND_CLI="$2"; LAUNCH=1; shift 2 ;;
    --agent) [ $# -ge 2 ] || die "--agent needs a provider or executable"; case "$2" in claude|codex|gemini|custom) PROVIDER_CLI="$2" ;; *) PROVIDER_CLI=custom; AGENT_COMMAND_CLI="$2" ;; esac; LAUNCH=1; shift 2 ;;
    --launch)    LAUNCH=1; shift ;;
    --no-launch) FORCE_NOLAUNCH=1; shift ;;
    *) die "unknown arg: $1 (see gsd-init --help)" ;;
  esac
done
# --no-launch always wins, whatever order it appeared in.
[ "$FORCE_NOLAUNCH" = 1 ] && LAUNCH=0
DEST="$(git rev-parse --show-toplevel 2>/dev/null)" \
  || die "run this from inside the target git repo"
command -v gsd-bootstrap-repo >/dev/null 2>&1 || die "gsd-bootstrap-repo not found on PATH"

SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh"
# shellcheck source=../lib/provider.sh
. "$GSD_PKG/lib/provider.sh"
# shellcheck source=../lib/version.sh
. "$GSD_PKG/lib/version.sh"
# shellcheck source=../lib/ui.sh
. "$GSD_PKG/lib/ui.sh"

# Build bootstrap arguments only after validating the complete selection. This
# prevents a typo or a launch provider outside the configured set from writing
# a partially initialized repository.
if [ -n "$PROVIDERS_CLI" ]; then
  gsd_provider_list_validate "$PROVIDERS_CLI" || exit $?
  [ -n "$PROVIDER_CLI" ] || PROVIDER_CLI=${PROVIDERS_CLI%%,*}
  case ",$PROVIDERS_CLI," in *",$PROVIDER_CLI,"*) ;; *) die "launch provider '$PROVIDER_CLI' is not listed in --providers $PROVIDERS_CLI" ;; esac
  BOOT_ARGS+=(--agents "$PROVIDERS_CLI")
elif [ -n "$PROVIDER_CLI" ]; then
  gsd_provider_known "$PROVIDER_CLI" || die "unknown provider '$PROVIDER_CLI'"
  BOOT_ARGS+=(--agent "$PROVIDER_CLI")
fi
if [ "$PROVIDER_COMMAND_COUNT" -gt 0 ]; then for provider_command in "${PROVIDER_COMMAND_ARGS[@]}"; do
  case "$provider_command" in
    *=*) command_provider=${provider_command%%=*}; command_value=${provider_command#*=} ;;
    *) die "--provider-command needs provider=executable" ;;
  esac
  [ -n "$command_provider" ] && [ -n "$command_value" ] || die "malformed --provider-command: $provider_command"
  gsd_provider_validate "$command_provider" "$command_value" || exit $?
  if [ -n "$PROVIDERS_CLI" ]; then
    case ",$PROVIDERS_CLI," in *",$command_provider,"*) ;; *) die "provider command '$command_provider' is not listed in --providers $PROVIDERS_CLI" ;; esac
  fi
  BOOT_ARGS+=(--provider-command "$provider_command")
done; fi
if [ -n "$AGENT_COMMAND_CLI" ]; then
  gsd_provider_validate "${PROVIDER_CLI:-claude}" "$AGENT_COMMAND_CLI" || exit $?
  if [ -n "$PROVIDERS_CLI" ]; then BOOT_ARGS+=(--provider-command "$PROVIDER_CLI=$AGENT_COMMAND_CLI")
  else BOOT_ARGS+=(--agent-command "$AGENT_COMMAND_CLI")
  fi
fi

gsd_update_notice   # a newer gsd-worktrees / GSD? one stderr line each, terminal only

# ── already initialized? (still repair/sync the workflow files below) ────────
# Validate the prospective session model before bootstrap writes files.
MODEL_PROVIDER=${PROVIDER_CLI:-${GSD_PROVIDER:-}}
if [ -z "$MODEL_PROVIDER" ]; then
  MODEL_PROVIDER=$(gsd_conf_get "$DEST" providers); MODEL_PROVIDER=${MODEL_PROVIDER%%,*}
  [ -n "$MODEL_PROVIDER" ] || MODEL_PROVIDER=$(gsd_conf_get "$DEST" provider)
  if [ -z "$MODEL_PROVIDER" ] && [ "$PROVIDER_COMMAND_COUNT" -gt 0 ]; then MODEL_PROVIDER=${PROVIDER_COMMAND_ARGS[0]%%=*}; fi
  MODEL_PROVIDER=${MODEL_PROVIDER:-${GSD_PROVIDER:-${GSD_AGENT:-claude}}}
fi
gsd_model_resolve "$DEST" "$MODEL_PROVIDER" "$MODEL_CLI" || exit $?
ALREADY=0
[ -f "$DEST/.planning/ROADMAP.md" ] && ALREADY=1

# ── step 1: install the workflow files (idempotent — also repairs/syncs) ─────
[ "$COMMIT" = 1 ] && BOOT_ARGS+=(--commit)
echo "▶ installing the GSD worktree workflow (gsd-bootstrap-repo)…"
echo ""
gsd-bootstrap-repo ${BOOT_ARGS[@]+"${BOOT_ARGS[@]}"}
echo ""

# Everything installed above is a TRACKED file except two, so `git diff` is the
# review — no --check flag needed, and no dry-run that could drift from what
# actually happens. Name the two git cannot show you.
ui_notice() {  # optional UI tools per configured provider (lib/provider.sh)
  [ "$(gsd_ui_gates "$DEST")" != off ] || return 0
  local p tip oldifs=$IFS printed=0
  IFS=,
  for p in $(gsd_conf_get "$DEST" providers); do
    tip=$(gsd_provider_ui_tip "$p") || continue
    [ "$printed" = 1 ] || { echo ""; echo "Optional, for better screens (the UI gates work without them):"; printed=1; }
    echo "  • $p: $tip"
  done
  IFS=$oldifs
}

review_notice() {
  echo "Review the tracked changes with:  git -C $DEST diff"
  echo "Also set, and NOT visible to git diff (per clone, not versioned):"
  echo "  • git config merge.gsd-planning.driver"
  # Where the hook lands, and whether it is versioned, is gsd_planning_hook's
  # call — asking it here keeps this message from drifting out of step with
  # what the bootstrap actually did.
  gsd_planning_hook "$DEST"
  [ "${GSD_HOOK_VERSIONED:-0}" = 1 ] \
    && echo "  • $GSD_HOOK_LABEL   (versioned — this one IS in the diff)" \
    || echo "  • $GSD_HOOK_LABEL"
}

if [ "$ALREADY" = 1 ]; then
  echo "• $DEST already has GSD planning state (.planning/ROADMAP.md) —"
  echo "  workflow files were repaired/synced, planning state left untouched."
  echo ""
  review_notice
  ui_notice
  echo ""
  echo "  Health check:  gsd-doctor"
  echo "  Start features with:  gsd-start -n \"<description>\""
  exit 0
fi

# ── step 2: pick the initialization skill ────────────────────────────────────
if [ -z "$MODE" ]; then
  DOCS=$(find "$DEST" -maxdepth 3 \
           \( -path '*/node_modules' -o -path '*/.git' -o -name '.planning' \) -prune -o \
           -type f \( -iname '*adr*.md' -o -iname '*prd*.md' -o -iname '*rfc*.md' \
                      -o -iname 'spec*.md' -o -iname 'requirements*.md' \
                      -o -iname 'architecture*.md' -o -iname 'design*.md' \) -print \
           2>/dev/null | head -8 || true)
  if [ -n "$DOCS" ]; then
    MODE=ingest
    echo "▶ found existing planning docs — will initialize by ingesting them:"
    printf '%s\n' "$DOCS" | sed "s|^$DEST/|    |"
    echo "  (use 'gsd-init --new' instead if these shouldn't seed the plan)"
  else
    MODE=new
    echo "▶ no planning docs found — will initialize with the project interview"
  fi
fi
gsd_provider_resolve "$DEST" "$PROVIDER_CLI" "$AGENT_COMMAND_CLI" || exit $?
gsd_model_resolve "$DEST" "$GSD_PROVIDER_RESOLVED" "$MODEL_CLI" || exit $?
CMD=$(gsd_provider_prompt "$GSD_PROVIDER_RESOLVED" "$MODE")
gsd_provider_argv "$GSD_PROVIDER_RESOLVED" "$GSD_AGENT_COMMAND_RESOLVED" "$CMD" "$GSD_MODEL_RESOLVED"
NEXT=$(gsd_provider_render "$DEST" "${GSD_LAUNCH_ARGV[@]}")

# ── step 3: open the session (the initialization itself is interactive) ──────
# The adapter builds an argv array; no shell template expansion is used.
if [ "$LAUNCH" = 1 ] && [ -t 0 ] && [ -t 1 ] && command -v "$GSD_AGENT_COMMAND_RESOLVED" >/dev/null 2>&1; then
  echo ""
  echo "▶ opening $GSD_PROVIDER_RESOLVED session in ${DEST}…"
  cd "$DEST"
  exec "${GSD_LAUNCH_ARGV[@]}"
else
  echo ""
  if [ "$LAUNCH" = 1 ] && ! command -v "$GSD_AGENT_COMMAND_RESOLVED" >/dev/null 2>&1; then
    echo "✖ provider executable '$GSD_AGENT_COMMAND_RESOLVED' not found — launch cancelled." >&2
    echo "Next (after installing it or changing agent_command):  $NEXT"
    exit 127
  fi
  ui_notice
  echo "Next:  $NEXT"
  echo "Then per feature:  gsd-start -n \"<description>\"  →  work  →  gsd-finish"
fi
