#!/usr/bin/env bash
#
# gsd-sync — update the gsd-worktrees toolkit and verify repo shims.
#
# One command for the whole maintenance loop:
#   1. self-update : pull the toolkit repo (rebase + autostash) and push any
#                    local commits. Edits made through the ~/.local/bin
#                    symlinks land in the repo working tree — gsd-sync reminds
#                    you when they're still uncommitted.
#   2. re-link     : re-run install.sh so commands added by the pull get their
#                    ~/.local/bin symlinks.
#   3. shim check  : verify the scripts/gsd-*.sh shims of the repo you RAN
#                    gsd-sync FROM match the package's shims/ (they're frozen
#                    delegators — logic lives in the package). Drift means a
#                    re-bootstrap is due: cd <repo> && gsd-init.
#
# Usage:
#   gsd-sync [--check] [--src <path>]
#
# Options:
#   --check       dry run: report what would change, change nothing
#   --src <path>  repo whose shims to check
#                 (default: $GSD_SRC_REPO, else the repo you run gsd-sync from;
#                 the check is skipped when you're not inside a project repo)
#   -h, --help    show this help
#
# RELATED
#   install.sh            what step 2 runs (symlink bin/ into ~/.local/bin)
#   gsd-init              re-run in a repo to refresh its config + shims
#   gsd-doctor            read-only health check of a repo's GSD setup
set -euo pipefail

die() { printf '✖ %s\n' "$@" >&2; exit 1; }

usage() {  # print the header comment block (everything up to the set line)
  awk 'NR>1 && /^set -euo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"
}

CHECK=0
SRCR="${GSD_SRC_REPO:-}"   # empty → the repo gsd-sync is run from
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --check|-n) CHECK=1; shift ;;
    --src) [ $# -ge 2 ] || die "--src needs a value"; SRCR="$2"; shift 2 ;;
    *) die "unknown argument: $1 (see gsd-sync --help)" ;;
  esac
done

# ── locate the toolkit repo by resolving our own symlink ─────────────────────
SELF="$0"
INSTALL_BIN=${GSD_BIN_DIR:-$HOME/.local/bin}
if [ -L "$SELF" ]; then INSTALL_BIN=$(cd "$(dirname "$SELF")" && pwd -P); fi
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
[ -d "$REPO/bin" ] && [ -f "$REPO/install.sh" ] \
  || die "could not locate the gsd-worktrees package from $0 (resolved to $REPO)"
# shellcheck source=lib/common.sh
. "$REPO/lib/common.sh"
START_DIR="$PWD"
cd "$REPO"

# Reference repo for the shim check: --src / GSD_SRC_REPO override; otherwise
# the repo gsd-sync was RUN FROM (its main checkout, so worktrees work too).
# Generic by design — no project path is baked into the toolkit.
if [ -z "$SRCR" ]; then
  SRCR="$(gsd_main "$START_DIR")"
  [ "$SRCR" = "$REPO" ] && SRCR=""   # the toolkit itself has no shims to check
fi

echo "toolkit repo : $REPO"
echo "reference    : ${SRCR:-(none — not inside a project repo)}"
[ "$CHECK" = 1 ] && echo "mode         : CHECK (dry run — nothing will change)"
echo ""

# ── step 1: self-update ──────────────────────────────────────────────────────
DIRTY=""
if [ ! -e "$REPO/.git" ]; then
  echo "• standalone copy — self-update and reinstall skipped (update with: gsd-update)"
elif [ -n "$(git status --porcelain)" ]; then
  DIRTY=$(git status --porcelain)
  echo "• toolkit repo has uncommitted changes (commit them so they're versioned):"
  git status --short | sed 's/^/    /'
fi
if [ ! -e "$REPO/.git" ]; then
  :
elif git remote get-url origin >/dev/null 2>&1; then
  if [ "$CHECK" = 1 ]; then
    echo '• remote comparison uses last fetched refs (read-only; no fetch)'
    if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
      behind=$(git rev-list --count 'HEAD..@{u}' 2>/dev/null || echo '?')
      ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo '?')
      echo "▶ would pull $behind commit(s), push $ahead commit(s)"
    fi
  else
    if git pull --rebase --autostash --quiet 2>/dev/null; then
      echo "✔ toolkit up to date with origin"
    else
      # A conflicted rebase must not stay in progress — every later git command
      # in the toolkit repo would misbehave. Abort restores the autostash too.
      git rebase --abort 2>/dev/null || true
      echo "• pull failed (offline, or rebase conflict) — continuing with local state"
    fi
    if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 \
       && [ "$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)" -gt 0 ]; then
      git push --quiet 2>/dev/null && echo "✔ local commits pushed" \
        || echo "• push failed — push manually when back online"
    fi
  fi
else
  echo "• no 'origin' remote — self-update skipped"
fi

# ── step 2: re-link (picks up commands added by the pull) ────────────────────
if [ ! -e "$REPO/.git" ]; then
  :
elif [ "$CHECK" = 1 ]; then
  echo "▶ would re-run install.sh"
else
  GSD_BIN_DIR="$INSTALL_BIN" ./install.sh --reuse-install-config | sed 's/^/  /'
fi
echo ""

# ── step 3: shim drift check (package shims/ vs the repo run from) ───────────
# Repo-side scripts are frozen shims delegating to the toolkit; if the target
# repo's copies differ from the package's shims/, a re-bootstrap is due —
# gsd-init re-runs the bootstrap, which overwrites shims idempotently.
# Skip, don't die: steps 1–2 (self-update + re-link) are still the whole
# point of running gsd-sync even when there is nothing to check here.
if [ -z "$SRCR" ] || [ ! -d "$SRCR/scripts" ]; then
  if [ -z "$SRCR" ]; then
    echo "• not inside a project repo — shim check skipped"
    echo "  (run gsd-sync from inside a GSD repo, or pass --src <path>)"
  else
    echo "• $SRCR has no scripts/ dir — shim check skipped (not bootstrapped yet?)"
  fi
  [ -n "$DIRTY" ] && echo "reminder: the toolkit repo still has uncommitted changes (see above)"
  exit 0
fi
ok=0; drift=0
while IFS= read -r rel; do
  [ -n "$rel" ] || continue
  if [ -f "$SRCR/$rel" ] && cmp -s "$REPO/shims/$rel" "$SRCR/$rel"; then
    ok=$((ok + 1))
  else
    [ -f "$SRCR/$rel" ] && echo "▶ shim drift: $rel (reference repo copy differs from the package shim)" \
                        || echo "▶ shim missing in reference repo: $rel"
    drift=$((drift + 1))
  fi
done < <( cd "$REPO/shims" && find scripts -type f -name 'gsd-*' ! -name '*.example' )

echo ""
if [ "$drift" -gt 0 ]; then
  echo "shims: $ok up to date · $drift out of date — refresh with:  cd $SRCR && gsd-init"
else
  echo "shims: all $ok up to date in $(basename "$SRCR")"
fi
[ -n "$DIRTY" ] && echo "reminder: the toolkit repo still has uncommitted changes (see above)"
exit 0
