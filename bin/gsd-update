#!/usr/bin/env bash
#
# gsd-update — update gsd-worktrees to the latest GitHub release, and GSD
# itself (gsd-core) to its latest version.
#
# Usage:
#   gsd-update                   install the latest release, if it is newer;
#                                then gsd-core for each installed agent
#   gsd-update --check           print the installed and latest versions only
#   gsd-update --version <X.Y.Z> install that release (also to go back)
#   gsd-update --no-core         leave gsd-core as it is
#
# gsd-core is updated for each agent the install chose (claude, codex), with
# the full skill profile; an agent without it gets it.
#
# Commands and skills are replaced in place; the agents you installed for are
# kept (install manifest). The release you had before stays on disk, so
# going back is `gsd-update --version <old>`.
#
# Run from a git checkout, it updates nothing: the checkout is pulled with
# git, and ./install.sh installs the release.
#
# Other commands (gsd-start, gsd-list) print one line when a newer release is
# out, at most one GitHub call a day; gsd-doctor reports it too.
# Env: GSD_NO_UPDATE_CHECK=1 turns those checks off; GSD_UPDATE_REPO=owner/name;
#      GSD_NO_CORE=1 same as --no-core (tests).
set -euo pipefail

die() { printf 'gsd-update: %s\n' "$*" >&2; exit 1; }
usage() { awk 'NR>1 && /^set -euo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"; }

CHECK=0; WANT=""; CORE=1
[ -z "${GSD_NO_CORE:-}" ] || CORE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --check|-n) CHECK=1; shift ;;
    --version) [ $# -ge 2 ] || die "--version needs X.Y.Z"; WANT=${2#v}; shift 2 ;;
    --no-core) CORE=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1 (see gsd-update --help)" ;;
  esac
done

SELF="$0"
INSTALL_BIN=${GSD_BIN_DIR:-$HOME/.local/bin}
if [ -L "$SELF" ]; then INSTALL_BIN=$(cd "$(dirname "$SELF")" && pwd -P); fi
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd -P)"
# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh"
# shellcheck source=../lib/version.sh
. "$GSD_PKG/lib/version.sh"

# shellcheck source=../lib/core.sh
. "$GSD_PKG/lib/core.sh"

CUR=$(gsd_version)
LATEST=$(gsd_latest_fetch)
if [ -n "$LATEST" ]; then
  f=$(gsd_update_cache); mkdir -p "$(dirname "$f")" 2>/dev/null && printf '%s\n' "$LATEST" > "$f" 2>/dev/null || true
fi
echo "installed : $CUR  ($GSD_PKG)"
echo "latest    : ${LATEST:-unknown (GitHub not reachable)}  ($(gsd_update_repo))"

if [ -e "$GSD_PKG/.git" ]; then
  echo "• this is a git checkout, not a release — pull it with git; install the release with: $GSD_PKG/install.sh"
  exit 0
fi

# gsd-core: the agents this install chose (its manifest), and npm's latest
AGENTS=$(sed -n $'s/^providers\t//p' "$INSTALL_BIN/.gsd-install-manifest" 2>/dev/null | head -1)
AGENTS=${AGENTS:-claude}
CORE_LATEST=""; CORE_BEHIND=0
if [ "$CORE" = 1 ]; then
  CORE_LATEST=$(gsd_gsd_fetch)
  if [ -n "$CORE_LATEST" ]; then
    f=$(gsd_gsd_cache); mkdir -p "$(dirname "$f")" 2>/dev/null && printf '%s\n' "$CORE_LATEST" > "$f" 2>/dev/null || true
  fi
  oldifs=$IFS; IFS=,
  for a in $AGENTS; do
    have=$(gsd_core_version "$a")
    echo "gsd-core  : $a ${have:-not installed}, latest ${CORE_LATEST:-unknown (npm not reachable)}"
    if [ -z "$have" ] || { [ -n "$CORE_LATEST" ] && gsd_version_gt "$CORE_LATEST" "$have"; }; then CORE_BEHIND=1; fi
  done
  IFS=$oldifs
fi

TOOLKIT_NEW=0
[ -n "$LATEST" ] && gsd_version_gt "$LATEST" "$CUR" && TOOLKIT_NEW=1
[ "$CHECK" = 0 ] || {
  if [ "$TOOLKIT_NEW" = 1 ] || [ "$CORE_BEHIND" = 1 ]; then echo "▶ update available: gsd-update"
  else echo "✔ up to date"; fi
  exit 0
}
if [ -z "$WANT" ]; then
  if [ "$TOOLKIT_NEW" = 1 ]; then WANT=$LATEST
  elif [ -n "$LATEST" ]; then echo "✔ gsd-worktrees is up to date"
  elif [ "$CORE" = 0 ]; then die "cannot find the latest release — try again online, or pass --version X.Y.Z"
  else echo "• gsd-worktrees not checked (GitHub not reachable)"
  fi
fi
if [ -n "$WANT" ]; then
  [ -f "$GSD_PKG/install.sh" ] || die "$GSD_PKG has no install.sh — reinstall once with the curl line in the README"
  # Keep this install's places: its bin dir, and (for a release runtime) its
  # releases dir. Anything else (an old --copy runtime) moves to the default.
  REL_DIR=""
  [ "$(basename "$(dirname "$GSD_PKG")")" != releases ] || REL_DIR=$(dirname "$GSD_PKG")
  GSD_BIN_DIR="$INSTALL_BIN" GSD_RELEASES_DIR="${REL_DIR:-${GSD_RELEASES_DIR:-}}" \
    bash "$GSD_PKG/install.sh" --version "$WANT" --reuse-install-config
fi

# After the toolkit, so a failed release download leaves gsd-core alone.
if [ "$CORE" = 1 ]; then
  oldifs=$IFS; IFS=,
  for a in $AGENTS; do gsd_core_sync "$a" update "$CORE_LATEST"; done
  IFS=$oldifs
fi
