#!/usr/bin/env bash
#
# gsd-worktree-guard — the GSD worktree guard, invoked as a Claude Code hook
# via a tiny per-repo shim (scripts/hooks/gsd-worktree-guard.sh) registered on:
#   - UserPromptExpansion  → catches TYPED /gsd-… slash commands
#   - PreToolUse (Skill)   → catches model-initiated Skill calls
#
# Rules (independent of how the command was invoked):
#   1. /gsd-phase            → only on the base branch (the shared claim point).
#   2. per-phase commands    → only inside the matching 'phase-<N>-*' worktree.
#   3. /gsd-execute-phase    → also requires deps installed (background install
#                              done) — skipped for repos with no install step.
#   4. phase-flow order      → OPT-IN via `flow = strict` in .gsd.conf. Each
#                              step must find the artifact the previous one
#                              leaves in .planning/phases/<P>-*/:
#                                plan-phase     needs <P>-CONTEXT.md   (discuss)
#                                               — unless --prd (express path)
#                                execute-phase  needs <P>-REVIEWS.md   (cross-AI
#                                               review) — unless --gaps-only
#                                secure-phase   needs <P>-REVIEW.md    (code
#                                               review) and, when a UI-SPEC
#                                               exists, <P>-UI-REVIEW.md — it is
#                                               the last code gate
#
# Block = exit 2 (stderr shown). Escape hatch: GSD_SKIP_GUARD=1.
# Repo settings (base branch, install cmd, flow): .gsd.conf, see gsd-bootstrap-repo.
set -uo pipefail

[ -n "${GSD_SKIP_GUARD:-}" ] && exit 0
input=$(cat 2>/dev/null || true)

SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh"

# Command + args from the known payload shapes:
#   UserPromptExpansion → .command_name / .command_args
#   PreToolUse(Skill)   → .tool_input.skill / .tool_input.args
if command -v jq >/dev/null 2>&1; then
  cmd=$(printf '%s' "$input" | jq -r '.command_name // .tool_input.skill // empty' 2>/dev/null || true)
  args=$(printf '%s' "$input" | jq -r '.command_args // .tool_input.args // empty' 2>/dev/null || true)
else
  cmd=$(printf '%s' "$input" | sed -n 's/.*"command_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  [ -z "$cmd" ] && cmd=$(printf '%s' "$input" | sed -n 's/.*"skill"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  args=$(printf '%s' "$input" | sed -n 's/.*"command_args"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
fi
cmd="${cmd:-}"; args="${args:-}"
case "$cmd" in gsd-*) ;; *) exit 0 ;; esac   # not a GSD command → allow

N=$(printf '%s' "$args" | grep -oE '[0-9]+(\.[0-9]+)?' | head -1 || true)

dir="${CLAUDE_PROJECT_DIR:-$PWD}"
branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
# gsd-core's parallel executors run in nested worktrees on agent-* branches
# (.claude/worktrees/agent-*). They are inside a phase worktree already, and
# the phase-<N>-* rule below would block them — let gsd-core's own workers pass.
case "$branch" in agent-*|worktree-agent-*) exit 0 ;; esac
BASE=$(gsd_base "$dir" 2>/dev/null || echo develop)

block() { printf '%s\n' "$@" >&2; exit 2; }

# Rule 1 — /gsd-phase only on the base branch
if [ "$cmd" = "gsd-phase" ]; then
  [ "$branch" = "$BASE" ] && exit 0
  block "BLOCKED: /gsd-phase must run on '$BASE' (main checkout), not '$branch'." \
        "Claim the phase number on $BASE first. See CLAUDE.md > GSD planning system."
fi

# Per-phase ("feature work") commands
case " gsd-discuss-phase gsd-plan-phase gsd-execute-phase gsd-ui-phase gsd-mvp-phase gsd-spec-phase gsd-ai-integration-phase gsd-verify-work gsd-secure-phase gsd-validate-phase gsd-code-review gsd-add-tests gsd-extract-learnings gsd-ui-review gsd-eval-review " in
  *" $cmd "*) ;;
  *) exit 0 ;;   # progress, help, map-codebase, resume-work, … allowed anywhere
esac

[ "$branch" = "$BASE" ] && block \
  "BLOCKED: /$cmd is feature work — run it in the phase worktree, not on $BASE." \
  "Create/open it with: gsd-start -p ${N:-<N>}  (then open a session in phase-${N:-<N>}-*). See CLAUDE.md."

[ -z "$N" ] && exit 0   # no phase number given; 'not the base branch' already satisfied

case "$branch" in
  phase-"$N"-*|phase-"$N") : ;;   # correct worktree
  phase-*) block "BLOCKED: you're in '$branch', but /$cmd targets phase $N. Switch to the phase-$N-* worktree." ;;
  *)       block "BLOCKED: /$cmd targets phase $N but '$branch' isn't a phase-$N-* worktree. See CLAUDE.md." ;;
esac

# Rule 3 — execute-phase needs deps installed (only for repos with an install step)
if [ "$cmd" = "gsd-execute-phase" ] && [ -n "$(gsd_install_cmd "$dir")" ] && [ ! -d "$dir/node_modules" ]; then
  s=$(cat "$dir/.gsd-install.status" 2>/dev/null || echo running)
  [ "$s" = "ok" ] && exit 0   # install completed (repo may simply have no deps)
  [ "$s" = "fail" ] && block "BLOCKED: dependency install FAILED — see $dir/.gsd-install.log, then install manually."
  [ "$s" = "skipped" ] && block "BLOCKED: the dependency install was skipped (--no-install) and node_modules is missing — run '$(gsd_install_cmd "$dir")' in the worktree first."
  block "BLOCKED: dependencies still installing (no node_modules yet). Wait, or install manually. Log: $dir/.gsd-install.log"
fi

# Rule 4 — phase-flow order (opt-in: `flow = strict` in .gsd.conf)
[ "$(gsd_conf_get "$dir" flow)" = "strict" ] || exit 0
case "$N" in *.*) P="$N" ;; *) P=$(printf '%02d' "$N") ;; esac
pdir=""; for d in "$dir/.planning/phases/$P"-*; do [ -d "$d" ] && { pdir="$d"; break; }; done
[ -n "$pdir" ] || exit 0   # no phase dir yet (fresh claim) — nothing to order
need() {  # $1=artifact suffix  $2=step that produces it  $3=command that runs it
  [ -f "$pdir/$P-$1" ] && return 0
  block "BLOCKED (flow = strict): /$cmd $N needs $P-$1 — $2 has not been done." \
        "Run: $3   (or GSD_SKIP_GUARD=1 if the user asked to skip it)"
}
case "$cmd" in
  gsd-plan-phase)
    case " $args " in *" --prd "*|*" --prd="*) ;; *) need CONTEXT.md "discuss-phase" "/gsd-discuss-phase $N" ;; esac ;;
  gsd-execute-phase)
    case " $args " in *" --gaps-only "*) ;; *) need REVIEWS.md "the cross-AI plan review" "/gsd-review --phase $N  then  /gsd-plan-phase $N --reviews" ;; esac ;;
  gsd-secure-phase)
    need REVIEW.md "the code review" "/gsd-code-review $N"
    [ -f "$pdir/$P-UI-SPEC.md" ] && need UI-REVIEW.md "ui-review (this phase has screens)" "/gsd-ui-review $N" ;;
esac

exit 0
