#!/usr/bin/env bash
#
# gsd-worktree-guard — shared validator called by gsd-start and gsd-flow-next.
# Optional native hooks use the same validator through a per-repo shim.
#
# Rules (independent of how the command was invoked):
#   1. /gsd-phase            → only on the base branch (the shared claim point).
#   2. per-phase commands    → only inside the matching 'phase-<N>-*' worktree.
#   3. /gsd-execute-phase    → also requires deps installed (background install
#                              done) — skipped for repos with no install step.
#   4. phase-flow order      → OPT-IN via `flow = strict` in .gsd.conf. Each
#                              step must find the artifact the previous one
#                              leaves in .planning/phases/<P>-*/:
#                                plan-phase     needs <P>-CONTEXT.md   (discuss)
#                                               — unless --prd (express path)
#                                execute-phase  needs <P>-REVIEWS.md   (cross-AI
#                                               review) — unless --gaps-only
#                                secure-phase   needs <P>-REVIEW.md    (code
#                                               review) and, when a UI-SPEC
#                                               exists, <P>-UI-REVIEW.md — it is
#                                               the last code gate
#
# Block = exit 2 (stderr shown). Escape hatch: GSD_SKIP_GUARD=1.
# Repo settings (base branch, install cmd, flow): .gsd.conf, see gsd-bootstrap-repo.
set -uo pipefail

[ "${GSD_SKIP_GUARD:-}" = 1 ] && exit 0
explicit_cmd=""; explicit_args=""; explicit_repo=""
while [ $# -gt 0 ]; do
  case "$1" in
    --command|--args|--phase|--repo)
      [ $# -ge 2 ] && [ -n "$2" ] || { echo "$1 needs a value" >&2; exit 64; }
      case "$1" in
        --command) explicit_cmd=$2 ;;
        --args) explicit_args=$2 ;;
        --phase)
          printf '%s' "$2" | grep -qE '^[0-9]+(\.[0-9]+)?$' || { echo "--phase needs a numeric phase" >&2; exit 64; }
          explicit_args="${explicit_args:+$explicit_args }$2" ;;
        --repo) explicit_repo=$2 ;;
      esac
      shift 2 ;;
    -h|--help) echo 'usage: gsd-worktree-guard [--command gsd-… --args "…" --repo <dir>]'; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 64 ;;
  esac
done
if [ -n "$explicit_cmd" ]; then input=""; cmd=${explicit_cmd#/}; args=$explicit_args
else input=$(cat 2>/dev/null || true); fi

SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh"

# Command + args from the known payload shapes:
#   UserPromptExpansion → .command_name / .command_args
#   PreToolUse(Skill)   → .tool_input.skill / .tool_input.args
gemini_tool=""
if [ -z "$explicit_cmd" ]; then
  if command -v jq >/dev/null 2>&1; then
    gemini_tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null || true)
  else
    gemini_tool=$(printf '%s' "$input" | sed -nE 's/.*"tool_name"[[:space:]]*:[[:space:]]*"(activate_skill|run_shell_command)".*/\1/p' | head -1)
  fi
fi
if [ -z "$explicit_cmd" ] && { [ "$gemini_tool" = activate_skill ] || [ "$gemini_tool" = run_shell_command ]; }; then
  # Gemini BeforeTool payloads need shell tokenization for direct commands.
  # A registered hook must not silently allow a GSD call when that parser is
  # unavailable or unable to classify the payload.
  py=$(gsd_python 2>/dev/null || true)
  [ -n "$py" ] || { echo 'BLOCKED: Gemini GSD hook needs Python 3.7+ to inspect tool calls.' >&2; exit 2; }
  hook_fields=()
  hook_field_count=0
  while IFS= read -r -d '' field; do
    hook_fields+=("$field")
    hook_field_count=$((hook_field_count + 1))
  done \
    < <(printf '%s' "$input" | "$py" "$GSD_PKG/lib/gsd_hook_payload.py")
  [ "$hook_field_count" -eq 4 ] || { echo 'BLOCKED: could not parse Gemini GSD tool call.' >&2; exit 2; }
  case "${hook_fields[0]}" in
    allow) exit 0 ;;
    block) printf 'BLOCKED: %s\n' "${hook_fields[1]}" >&2; exit 2 ;;
    guard) cmd=${hook_fields[1]}; args=${hook_fields[2]}; explicit_repo=${hook_fields[3]} ;;
    *) echo 'BLOCKED: invalid Gemini GSD hook result.' >&2; exit 2 ;;
  esac
elif [ -z "$explicit_cmd" ] && command -v jq >/dev/null 2>&1; then
  if ! printf '%s' "$input" | jq -e 'type == "object" and
    ((.command_name // .tool_input.skill // "") | type == "string") and
    ((.command_args // .tool_input.args // "") | type == "string")' >/dev/null 2>&1; then
    echo 'BLOCKED: invalid Claude hook payload.' >&2; exit 2
  fi
  cmd=$(printf '%s' "$input" | jq -r '.command_name // .tool_input.skill // empty' 2>/dev/null || true)
  args=$(printf '%s' "$input" | jq -r '.command_args // .tool_input.args // empty' 2>/dev/null || true)
elif [ -z "$explicit_cmd" ]; then
  py=$(gsd_python 2>/dev/null || true)
  [ -n "$py" ] || { echo 'BLOCKED: Claude hook needs jq or Python 3.7+ to inspect tool calls.' >&2; exit 2; }
  hook_fields=(); hook_field_count=0
  while IFS= read -r -d '' field; do
    hook_fields+=("$field"); hook_field_count=$((hook_field_count + 1))
  done < <(printf '%s' "$input" | "$py" "$GSD_PKG/lib/gsd_hook_payload.py" --claude)
  [ "$hook_field_count" -eq 4 ] || { echo 'BLOCKED: could not parse Claude hook payload.' >&2; exit 2; }
  case "${hook_fields[0]}" in
    allow) exit 0 ;;
    guard) cmd=${hook_fields[1]}; args=${hook_fields[2]} ;;
    *) printf 'BLOCKED: %s\n' "${hook_fields[1]}" >&2; exit 2 ;;
  esac
fi
cmd="${cmd:-}"; args="${args:-}"
cmd=${cmd#/}
case "$cmd" in gsd-*) ;; *) exit 0 ;; esac   # not a GSD command → allow

N=$(printf '%s' "$args" | grep -oE '[0-9]+(\.[0-9]+)?' | head -1 || true)
# Phase dirs are zero-padded (08-slug), so users type "08"; branches are not
# (phase-8-slug). Compare as numbers: drop leading zeros from the integer part.
case "$N" in 0?*) int=${N%%.*}; N="$((10#$int))${N#"$int"}" ;; esac

dir="${explicit_repo:-${CLAUDE_PROJECT_DIR:-${GEMINI_PROJECT_DIR:-$PWD}}}"
dir=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$dir")
branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
# Nested workers inherit phase identity only from a containing checkout in the
# same Git repository. A branch name alone never bypasses the guard.
case "$branch" in agent-*|worktree-agent-*)
  worker_common=$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null || true)
  worker_common=$(cd "$dir" && cd "$worker_common" 2>/dev/null && pwd -P)
  parent=$(dirname "$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || echo "$dir")")
  while [ "$parent" != / ]; do
    parent_branch=$(git -C "$parent" branch --show-current 2>/dev/null || true)
    case "$parent_branch" in phase-*)
      parent_common=$(git -C "$parent" rev-parse --git-common-dir)
      parent_common=$(cd "$parent" && cd "$parent_common" && pwd -P)
      [ "$worker_common" != "$parent_common" ] || branch=$parent_branch
      break ;;
    esac
    parent=$(dirname "$parent")
  done ;;
esac
BASE=$(gsd_base "$dir" 2>/dev/null || echo develop)

block() { printf '%s\n' "$@" >&2; exit 2; }

# Rule 1 — /gsd-phase only on the base branch
if [ "$cmd" = "gsd-phase" ]; then
  [ "$branch" = "$BASE" ] && exit 0
  block "BLOCKED: /gsd-phase must run on '$BASE' (main checkout), not '$branch'." \
        "Claim the phase number on $BASE first. See .gsd/INSTRUCTIONS.md."
fi

# Per-phase ("feature work") commands
case " gsd-flow gsd-review gsd-discuss-phase gsd-plan-phase gsd-execute-phase gsd-ui-phase gsd-mvp-phase gsd-spec-phase gsd-ai-integration-phase gsd-verify-work gsd-secure-phase gsd-validate-phase gsd-code-review gsd-add-tests gsd-extract-learnings gsd-ui-review gsd-eval-review " in
  *" $cmd "*) ;;
  *) exit 0 ;;   # progress, help, map-codebase, resume-work, … allowed anywhere
esac

[ "$branch" = "$BASE" ] && block \
  "BLOCKED: /$cmd is feature work — run it in the phase worktree, not on $BASE." \
  "Create/open it with: gsd-start -p ${N:-<N>}  (then open a session in phase-${N:-<N>}-*). See .gsd/INSTRUCTIONS.md."

if [ -z "$N" ]; then
  N=$(printf '%s' "$branch" | sed -nE 's/^phase-([0-9]+(\.[0-9]+)?)(-.*)?$/\1/p')
  [ -n "$N" ] || block "BLOCKED: /$cmd requires a phase number and matching phase worktree."
fi

case "$branch" in
  phase-"$N"-*|phase-"$N") : ;;   # correct worktree
  phase-*) block "BLOCKED: you're in '$branch', but /$cmd targets phase $N. Switch to the phase-$N-* worktree." ;;
  *)       block "BLOCKED: /$cmd targets phase $N but '$branch' isn't a phase-$N-* worktree. See .gsd/INSTRUCTIONS.md." ;;
esac

# Rule 3 — execute-phase needs deps installed (only for repos with an install step)
if [ "$cmd" = "gsd-execute-phase" ] && [ -n "$(gsd_install_cmd "$dir")" ]; then
  s=$(cat "$dir/.gsd-install.status" 2>/dev/null || echo unknown)
  [ "$s" = "fail" ] && block "BLOCKED: dependency install FAILED — see $dir/.gsd-install.log, then install manually."
  [ "$s" = "running" ] && block "BLOCKED: dependencies still installing. Log: $dir/.gsd-install.log"
  if [ "$s" != ok ] && [ ! -d "$dir/node_modules" ]; then
    block "BLOCKED: dependency installation is not complete (status: $s). Run '$(gsd_install_cmd "$dir")' successfully and record ok in .gsd-install.status."
  fi
fi

# Rule 4 — phase-flow order (opt-in: `flow = strict` in .gsd.conf)
# Policy is read from the MAIN checkout's .gsd.conf, not the worktree's copy, so
# turning it on takes effect for worktrees branched before the key existed.
[ "$(gsd_conf_get "$(gsd_main "$dir" 2>/dev/null || echo "$dir")" flow)" = "strict" ] || exit 0
case "$N" in *.*) P="$N" ;; *) P=$(printf '%02d' "$((10#$N))") ;; esac
pdir=""; for d in "$dir/.planning/phases/$P"-*; do [ -d "$d" ] && { pdir="$d"; break; }; done
need() {  # $1=artifact suffix  $2=step that produces it  $3=command that runs it
  [ -n "$pdir" ] && [ -f "$pdir/$P-$1" ] && return 0
  block "BLOCKED (flow = strict): /$cmd $N needs $P-$1 — $2 has not been done." \
        "Run: $3   (or GSD_SKIP_GUARD=1 if the user asked to skip it)"
}
case "$cmd" in
  gsd-plan-phase)
    case " $args " in *" --prd "*|*" --prd="*) ;; *) need CONTEXT.md "discuss-phase" "/gsd-discuss-phase $N" ;; esac ;;
  gsd-execute-phase)
    case " $args " in *" --gaps-only "*) ;; *) need REVIEWS.md "the cross-AI plan review" "/gsd-review --phase $N  then  /gsd-plan-phase $N --reviews" ;; esac ;;
  gsd-secure-phase)
    need REVIEW.md "the code review" "/gsd-code-review $N"
    [ -f "$pdir/$P-UI-SPEC.md" ] && need UI-REVIEW.md "ui-review (this phase has screens)" "/gsd-ui-review $N" ;;
esac

exit 0
