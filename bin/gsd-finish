#!/usr/bin/env bash
#
# gsd-finish — finish a GSD phase from anywhere: merge the phase worktree back
# into the base branch, push, and remove the worktree + branch.
#
# Companion to gsd-start. Delegates the merge/cleanup to the repo's own
# scripts/gsd-finish-worktree-feature.sh (single source of truth, synced by
# gsd-bootstrap-repo), but adds what a shared command can:
#   - no argument needed when run from inside a phase worktree (phase is
#     inferred from the current branch)
#   - auto-switches the main checkout back to the base branch when it was left
#     parked on another branch (only if it is clean)
#   - safe to run from inside the worktree being removed (runs from the main
#     checkout, prints where to cd afterwards)
#
# Usage:
#   gsd-finish                      # from inside a phase-N-* worktree
#   gsd-finish <N | phase-N-slug>   # from anywhere in the repo
#   gsd-finish <N> --repo <path>    # from outside the repo
set -euo pipefail

die() { printf '✖ %s\n' "$@" >&2; exit 1; }

usage() {
  cat <<'HELP'
gsd-finish — finish a GSD phase: merge back, push, clean up

Merges the phase worktree's branch into the base branch, pushes, and removes
the worktree + branch. Companion to gsd-start; delegates the merge/cleanup to
the repo's scripts/gsd-finish-worktree-feature.sh.

USAGE
  gsd-finish [<N> | phase-<N>-<slug>] [options]

  With no phase argument, run it from INSIDE the phase worktree — the phase is
  inferred from the current branch.

OPTIONS
  --repo <path>   any checkout of the target repo (default: derived from the
                  current directory)
  --pr            do NOT merge: push the phase branch and open a GitHub PR
                  against the base branch (needs gh). Uses the *-pr branch
                  from /gsd-pr-branch when one exists (planning commits
                  stripped), else the phase branch itself. Worktree stays;
                  run gsd-finish again (without --pr) once the PR is merged.
  --draft         with --pr: open it as a draft
  -h, --help      show this help

EXAMPLES
  gsd-finish
      From inside ../<repo>-worktrees/phase-7-invoice-fix: merges phase 7,
      pushes, removes the worktree and branch.

  gsd-finish 7
      Same, from anywhere inside the repo or its worktrees.

  gsd-finish phase-7-invoice-fix
      Same, naming the branch explicitly.

  gsd-finish 7 --repo ~/projects/acme/webshop
      Finish a phase of another repo without cd-ing into it first.

BEHAVIOR
  - If the main checkout was left on another branch, it is switched back to
    the base branch automatically (only when it has no uncommitted changes).
  - Safe to run from inside the worktree being removed; afterwards cd to the
    main checkout (the command prints the path).
  - Refuses if the worktree has uncommitted changes — commit them first.
  - Validates the phase and combined base tree, including remote push retries.
    Failed sync/validation prevents push and cleanup; any merge remains local.
  - ROADMAP.md/STATE.md use the reconciling gsd-planning merge driver.
  - ClickUp: when the branch name or ROADMAP phase title carries cu_<id>, the
    story is moved to its list's testing/review status with a merge comment
    (status name resolved against the list's own statuses; best-effort, via
    gsd-clickup — needs a token in ~/.config/gsd/clickup.env).

RELATED
  gsd-start             start a phase (claim + worktree + session) in one step
  gsd-init              set up GSD in a repo that doesn't have it yet
  gsd-bootstrap-repo    just the file installation (what gsd-init wraps)
HELP
}

ID=""
REPO=""
PR=0
DRAFT=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --repo) [ $# -ge 2 ] || die "--repo needs a value"; REPO="$2"; shift 2 ;;
    --pr) PR=1; shift ;;
    --draft) DRAFT=1; shift ;;
    -*) die "unknown flag: $1 (see gsd-finish --help)" ;;
    *)  [ -z "$ID" ] || die "unexpected argument: $1 (see gsd-finish --help)"; ID="$1"; shift ;;
  esac
done

# ── locate the main checkout ─────────────────────────────────────────────────
if [ -n "$REPO" ]; then
  cd "$REPO" 2>/dev/null || die "--repo path not found: $REPO"
fi
git rev-parse --show-toplevel >/dev/null 2>&1 \
  || die "not inside a git repo — cd into the repo/worktree or pass --repo <path>"
# ── locate the toolkit package (shared lib + worker commands) ────────────────
SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"
[ -f "$GSD_PKG/lib/common.sh" ] || die "gsd-worktrees toolkit lib not found (looked in $GSD_PKG/lib) — reinstall with install.sh"
# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh"

MAIN=$(gsd_main .)
FINISH="$GSD_PKG/bin/gsd-wt-finish"
BASE=$(gsd_base "$MAIN")
[ -n "$BASE" ] || die "could not determine the base branch — set 'base = <branch>' in $MAIN/.gsd.conf"

# ── local lock: serialize gsd commands touching this checkout ────────────────
# Same lock as gsd-start. Logic: gsd_acquire_lock, lib/common.sh. The export
# tells the delegated worker (gsd-wt-finish) the lock is already held — the
# re-entrancy guard; it is deliberate that only gsd-finish exports it, because
# everything it runs afterwards stays inside this one finish.
gsd_acquire_lock "$MAIN"
export GSD_LOCK_HELD=1

# ── infer the phase from the current worktree when no argument given ─────────
if [ -z "$ID" ]; then
  br=$(git branch --show-current 2>/dev/null || true)
  case "$br" in
    phase-*) ID="$br" ;;
    *) die "no phase given and current branch '$br' is not a phase-* worktree" \
           'usage: gsd-finish [N | phase-N-slug] [--repo <path>]' ;;
  esac
fi

# ── main checkout must be on the base branch (auto-switch when clean) ────────
printf '%s' "$ID" | grep -qE '^([0-9]+(\.[0-9]+)?|phase-[0-9]+(\.[0-9]+)?-.+)$' \
  || die 'finish requires a phase number or phase-N-slug branch'
case "$ID" in *-pr) die 'finish the phase branch, not a PR-helper branch' ;; esac
cur=$(git -C "$MAIN" branch --show-current)
if [ "$cur" != "$BASE" ]; then
  [ -z "$(git -C "$MAIN" status --porcelain)" ] \
    || die "main checkout is on '$cur' with uncommitted changes — clean it up, then re-run"
  echo "▶ main checkout was on '$cur' — switching to '$BASE'…"
  git -C "$MAIN" checkout -q "$BASE"
fi

# ── resolve the ClickUp story BEFORE the branch is deleted ───────────────────
# Convention: the story id rides in the branch name (phase-N-slug-cu_<id>) or,
# failing that, in the phase's ROADMAP.md title. Captured here, acted on after
# the merge succeeds. Best-effort throughout — never blocks the finish.
CU_ID=""
PHASE_N=""
if command -v gsd-clickup >/dev/null 2>&1; then
  case "$ID" in
    phase-*) BR="$ID"; PHASE_N=$(printf '%s' "$ID" | sed -E 's/^phase-([0-9]+(\.[0-9]+)?)-.*/\1/') ;;
    *)       PHASE_N="$ID"
             BR=$(git -C "$MAIN" for-each-ref --format='%(refname:short)' "refs/heads/phase-$ID-*" \
                    | grep -v -- '-pr$' | head -1 || true) ;;
  esac
  CU_ID=$(gsd-clickup extract "${BR:-}" 2>/dev/null || true)
  if [ -z "$CU_ID" ] && [ -n "$PHASE_N" ] && [ -f "$MAIN/.planning/ROADMAP.md" ]; then
    N_RE=$(printf '%s' "$PHASE_N" | sed 's/\./\\./g')
    TITLE=$(grep -E "^### Phase $N_RE:" "$MAIN/.planning/ROADMAP.md" | head -1 || true)
    CU_ID=$(gsd-clickup extract "${TITLE:-}" 2>/dev/null || true)
  fi
fi

# ── --pr: push + open a PR instead of merging ────────────────────────────────
# For repos with branch protection. Nothing is merged or removed; the normal
# finish runs later, after the PR lands, to clean the worktree and branch.
if [ "$PR" = 1 ]; then
  command -v gh >/dev/null 2>&1 || die "--pr needs the GitHub CLI (gh) on PATH"
  case "$ID" in
    phase-*) BR="$ID" ;;
    *) BR=$(git -C "$MAIN" for-each-ref --format='%(refname:short)' "refs/heads/phase-$ID-*" \
              | grep -v -- '-pr$' | head -1 || true)
       [ -n "$BR" ] || die "no phase-$ID-* branch found" ;;
  esac
  PHASE_N=$(printf '%s' "$BR" | sed -E 's/^phase-([0-9]+(\.[0-9]+)?)-.*/\1/')
  HEAD_BR="$BR"
  git -C "$MAIN" show-ref --verify --quiet "refs/heads/$BR-pr" && HEAD_BR="$BR-pr"
  echo "▶ pushing '$HEAD_BR'…"
  # No retry loop here: a rejected push means origin has commits this branch
  # lacks, and only the user can say how to integrate them.
  git -C "$MAIN" push -u origin "$HEAD_BR" --quiet \
    || die "push of '$HEAD_BR' failed — if origin has newer commits, run 'git pull --rebase origin $HEAD_BR' where that branch is checked out, then rerun gsd-finish --pr"
  N_RE=$(printf '%s' "${PHASE_N:-x}" | sed 's/\./\\./g')
  TITLE=$(grep -E "^### Phase $N_RE:" "$MAIN/.planning/ROADMAP.md" 2>/dev/null | head -1 | sed -E 's/^### //' || true)
  echo "▶ opening PR $HEAD_BR → $BASE…"
  gh pr create --repo "$(git -C "$MAIN" remote get-url origin)" --base "$BASE" --head "$HEAD_BR" \
     --title "${TITLE:-$HEAD_BR}" --fill-verbose ${DRAFT:+--draft} 2>/dev/null \
  || gh pr create --base "$BASE" --head "$HEAD_BR" --title "${TITLE:-$HEAD_BR}" --body "" ${DRAFT:+--draft} \
  || die "gh pr create failed (is origin a GitHub repo and gh authenticated?)"
  [ -z "$CU_ID" ] || gsd-clickup finish "$CU_ID" "🔀 GSD phase ${PHASE_N:-?}: PR opened $HEAD_BR → $BASE" \
     || echo "• ClickUp story $CU_ID not updated (non-fatal)"
  echo ""
  echo "Worktree kept. After the PR merges:  gsd-finish $BR"
  exit 0
fi

# Run from the main checkout so removing the worktree we may be standing in is
# safe; the toolkit worker does the merge → push → cleanup.
cd "$MAIN"
"$FINISH" "$ID" "$BASE"

# ── ClickUp write-back (best-effort): story → "in testing" + merge comment ───
if [ -n "$CU_ID" ]; then
  SHA=$(git -C "$MAIN" rev-parse --short "$BASE" 2>/dev/null || echo "?")
  gsd-clickup finish "$CU_ID" \
    "✅ GSD phase ${PHASE_N:-?} merged to $BASE — commit $SHA in $(basename "$MAIN"). Ready for testing." \
    || echo "• ClickUp story $CU_ID not updated (non-fatal) — check gsd-clickup check / your token"
fi

# ── roadmap bookkeeping (best-effort, never blocks) ──────────────────────────
# The merge is the moment the phase's tracking rows land on the base branch, so
# it is the last cheap chance to notice that upstream's phase.insert /
# phase.complete quietly failed to write or tick them. Warn only: the finish has
# already succeeded by here, and a stale checkbox is not worth a red exit.
if command -v gsd-doctor >/dev/null 2>&1; then
  bookkeeping="$(gsd-doctor --repo "$MAIN" --quiet 2>/dev/null | grep -E 'checklist row|Progress table|tick' || true)"
  if [ -n "$bookkeeping" ]; then
    echo ""
    echo "⚠ roadmap bookkeeping needs a hand (the merge itself is fine):"
    printf '%s\n' "$bookkeeping"
    echo "  full report: gsd-doctor"
  fi
fi

echo ""
echo "If your shell was inside the removed worktree:  cd $MAIN"
