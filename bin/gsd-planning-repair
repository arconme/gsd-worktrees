#!/usr/bin/env bash
#
# gsd-planning-repair — reconcile .planning/ROADMAP.md + STATE.md and recompute
# their derived counters from ground truth.
#
# The union merge strategy on these files is right for append-only content and
# wrong for every line that is a single source of truth: when a phase branch
# flips a line the base branch also changed, union keeps BOTH sides and the file
# starts claiming a phase is simultaneously complete and not started. This
# collapses those lines back to one value, and recomputes the counters — which
# cannot be fixed by picking a side, because after a real phase-11 merge NEITHER
# frontmatter block was right (30/12/96 vs 28/11/103; the truth was 30/13/111).
#
# Counters are recomputed from:
#   phases   .planning/ROADMAP.md — '### Phase N' headings ∪ '- [x] **Phase N'
#   plans    .planning/phases/*/*-PLAN.md
#   summaries .planning/phases/*/*-SUMMARY.md
#
# STATE.md's "## Session Continuity" section is never touched: its
# 'Last session:' / 'Stopped at:' / 'Resume file:' lines are one entry per past
# session and legitimately repeat, so every single-value dedupe is scoped to the
# block that owns the field.
#
# Idempotent — running it twice changes nothing the second time.
#
# Usage:
#   gsd-planning-repair [--check] [--commit] [--repo <path>]
#
# Options:
#   --check        report only, change nothing. Exits 1 if union-merge damage is
#                  present (the CI guard); advisories alone still exit 0.
#   --commit       commit the repair if it changed anything (no-op when clean)
#   --repo <path>  repo to operate on (default: the checkout containing cwd)
#   -h, --help     show this help
#
# WHERE IT RUNS
#   gsd-finish     automatically, after the phase merge and after any
#                  origin-sync merge on the push-retry path
#   post-merge     the git hook installed by gsd-bootstrap-repo, so a plain
#                  `git pull` on the base branch is covered too
#   CI             `gsd-planning-repair --check` on the shared branch
#
# RELATED
#   gsd-planning-merge   the merge driver that stops the damage landing at all
set -euo pipefail

die() { printf '✖ %s\n' "$@" >&2; exit 1; }

usage() { awk 'NR>1 && /^set -euo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"; }

SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh"

CHECK=0
COMMIT=0
REPO=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --check|-n) CHECK=1; shift ;;
    --commit) COMMIT=1; shift ;;
    --repo) [ $# -ge 2 ] || die "--repo needs a value"; REPO="$2"; shift 2 ;;
    *) die "unknown argument: $1 (see gsd-planning-repair --help)" ;;
  esac
done

[ "$CHECK" = 1 ] && [ "$COMMIT" = 1 ] && die "--check and --commit are mutually exclusive"

if [ -z "$REPO" ]; then
  REPO="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || die "not inside a git repository — pass --repo <path>"
fi
[ -d "$REPO/.planning" ] || die "$REPO has no .planning/ directory"

command -v python3 >/dev/null 2>&1 \
  || die "python3 not found — gsd-planning-repair needs it to parse the planning files"

ARGS=(repair "$REPO/.planning")
[ "$CHECK" = 1 ] && ARGS+=(--check)

rc=0
python3 "$GSD_PKG/lib/gsd_planning.py" "${ARGS[@]}" || rc=$?

if [ "$COMMIT" = 1 ] && [ -n "$(git -C "$REPO" status --porcelain -- .planning)" ]; then
  # Stage only what exists: a repo may legitimately have ROADMAP.md without
  # STATE.md, and `git add` on a missing pathspec is fatal — which, called from
  # gsd-finish, aborted the repair with the merge already committed.
  STAGE=()
  for f in .planning/ROADMAP.md .planning/STATE.md; do
    [ -f "$REPO/$f" ] && STAGE+=("$f")
  done
  [ "${#STAGE[@]}" -gt 0 ] && git -C "$REPO" add -- "${STAGE[@]}"
  if ! git -C "$REPO" diff --cached --quiet -- .planning; then
    git -C "$REPO" commit -q -m "docs(gsd): reconcile .planning after union merge

Collapsed the both-sides lines union left behind and recomputed the
progress counters from the roadmap and the plan/summary files on disk.
Generated by gsd-planning-repair."
    echo "✔ committed the .planning repair"
  fi
fi

exit "$rc"
