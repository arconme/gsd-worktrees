#!/usr/bin/env bash
#
# gsd-wt-finish — merge a finished phase worktree back into the base branch,
# push, and clean up the worktree + branch. The worker behind gsd-finish;
# callable standalone too.
#
# Usage (from inside the target repo):
#   gsd-wt-finish <N | phase-N-slug> [base]
#   gsd-wt-finish 1                       # finds phase-1-* (never *-pr)
#   gsd-wt-finish phase-1-customer-onboarding-terms
#
# Safety: refuses if the worktree has uncommitted changes or if the main
# checkout isn't on the base branch. A conflicting merge is aborted — the base
# branch is left clean and the resolution steps are printed. Parallel runs
# serialize on .git/gsd-cmd.lock (stale locks from crashed runs are reclaimed).
#
# .planning reconcile: ROADMAP.md and STATE.md merge with a union strategy so
# parallel sessions can each append their own entries. Union keeps BOTH sides of
# any line that is a single source of truth, so this command registers the
# reconciling merge driver (gsd-planning-merge) and runs gsd-planning-repair
# after BOTH merge points — the phase merge, and the `pull` on the push-retry
# path, which fires exactly when a parallel session moved the base branch. The
# base branch is never pushed while .planning contradicts itself.
#
# Pre-merge check hook: if the repo has an executable pre-merge script
# (default scripts/gsd-premerge-check.sh, override with `premerge = <path>` in
# .gsd.conf, 'none' disables), it runs from the main checkout AFTER the origin
# sync and BEFORE the merge, as `<script> <branch> <base>`. Nonzero exit
# aborts the finish with nothing merged — the place for repo-specific
# validations like migration-timestamp collision checks. Without that script
# the project's test suite runs instead (`test = <cmd>` in .gsd.conf, 'none'
# disables; otherwise detected: xcodebuild/make/just/cargo/go/npm/pytest).
# The validator runs again on the combined main checkout after the phase merge
# and every remote retry, before pushing. Ensure its test dependencies exist
# there too. Failure keeps any local merge and the phase worktree for recovery.
#
# Repo settings (base branch, worktree dir): .gsd.conf, see gsd-bootstrap-repo.
# The old per-repo copy of this logic (scripts/gsd-finish-worktree-feature.sh)
# is now a shim that delegates here.
set -euo pipefail

SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh"

ID="${1:-}"
if [ -z "$ID" ]; then
  echo "usage: gsd-wt-finish <N | phase-N-slug> [base]" >&2; exit 1
fi

MAIN=$(gsd_main .)
[ -n "$MAIN" ] || { echo "error: not inside a git repository" >&2; exit 1; }
BASE="${2:-$(gsd_base "$MAIN")}"

# ── serialize on the shared main checkout ────────────────────────────────────
# Same lock as gsd-start/gsd-finish; parallel finishes would otherwise race on
# the one base-branch working tree. Skipped when the caller already holds it
# (gsd-finish exports GSD_LOCK_HELD=1). Logic: gsd_acquire_lock, lib/common.sh.
gsd_acquire_lock "$MAIN"

# Resolve the branch: a bare number → the phase-<N>-* branch; else use as-is.
# PR branches (*-pr, from /gsd-pr-branch) are never the feature branch.
if printf '%s' "$ID" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
  BRANCH=$(git -C "$MAIN" for-each-ref --format='%(refname:short)' "refs/heads/phase-$ID-*" \
             | grep -v -- '-pr$' | head -1 || true)
  [ -n "$BRANCH" ] || { echo "error: no 'phase-$ID-*' branch found" >&2; exit 1; }
else
  printf '%s' "$ID" | grep -qE '^phase-[0-9]+(\.[0-9]+)?-.+$' || {
    echo "error: finish requires a phase number or phase-N-slug branch" >&2; exit 1;
  }
  case "$ID" in *-pr) echo 'error: finish the phase branch, not a PR-helper branch' >&2; exit 1 ;; esac
  BRANCH="$ID"
fi

if ! git -C "$MAIN" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  echo "error: branch '$BRANCH' not found" >&2; exit 1
fi
# The branch's actual worktree path, from git itself (a worktree can live
# outside the conventional sibling dir).
DEST=$(git -C "$MAIN" worktree list --porcelain \
        | awk -v b="branch refs/heads/$BRANCH" '/^worktree /{w=substr($0,10)} $0==b{print w; exit}')
[ -n "$DEST" ] || DEST="$(dirname "$MAIN")/$(gsd_wtdir "$MAIN")/$BRANCH"

if [ -d "$DEST" ] && [ -n "$(git -C "$DEST" status --porcelain)" ]; then
  echo "error: $DEST has uncommitted changes — commit them in the worktree first" >&2; exit 1
fi
cur=$(git -C "$MAIN" branch --show-current)
if [ "$cur" != "$BASE" ]; then
  echo "error: main checkout is on '$cur', not '$BASE' (git -C \"$MAIN\" checkout $BASE), then re-run." >&2
  exit 1
fi

# ── .planning merge safety ───────────────────────────────────────────────────
# The union merge strategy on .planning/ROADMAP.md + STATE.md keeps BOTH sides
# of any single-value line, which leaves the roadmap claiming a phase is at once
# complete and not started. Register the reconciling merge driver (config is not
# versioned, so re-assert it every run) and repair after each merge point below.
gsd_register_merge_driver "$MAIN"

repair_planning() {  # $1 = a phrase naming the merge that just happened
  [ -d "$MAIN/.planning" ] || return 0
  # No ROADMAP.md → nothing to reconcile. The repair tool exits 2 on this, and
  # letting that reach the --check below would read as "corrupt — not pushing".
  [ -f "$MAIN/.planning/ROADMAP.md" ] || return 0
  if ! command -v gsd-planning-repair >/dev/null 2>&1; then
    echo "⚠ gsd-planning-repair not on PATH — skipping the .planning reconcile (re-run install.sh)" >&2
    return 0
  fi
  echo "▶ reconciling .planning after $1…"
  gsd-planning-repair --repo "$MAIN" --commit \
    || echo "⚠ .planning reconcile exited nonzero — verifying before we go on" >&2

  # Assert the guarantee rather than assume it, and assert it even when the
  # repair itself failed: an early return here would let a failed reconcile push
  # the merge unverified. Two things must hold — the files must be coherent, and
  # the repair must have been COMMITTED, since --check reads the working tree
  # and a repaired-but-uncommitted tree would push the corruption anyway.
  if ! gsd-planning-repair --repo "$MAIN" --check >/dev/null 2>&1; then
    echo "✗ .planning is STILL self-contradictory after the repair — not pushing." >&2
    gsd-planning-repair --repo "$MAIN" --check >&2 || true
    echo "  The merge is committed locally only. Fix .planning, commit, then re-run finish." >&2
    return 1
  fi
  if [ -n "$(git -C "$MAIN" status --porcelain -- .planning)" ]; then
    echo "✗ the .planning repair was not committed — not pushing." >&2
    git -C "$MAIN" status --short -- .planning >&2
    echo "  Commit it, then re-run finish." >&2
    return 1
  fi
}

HAS_ORIGIN=0
git -C "$MAIN" remote get-url origin >/dev/null 2>&1 && HAS_ORIGIN=1

if [ "$HAS_ORIGIN" = 1 ]; then
  echo "▶ syncing local '$BASE' with origin…"
  if ! git -C "$MAIN" fetch origin "$BASE" --quiet \
    || ! git -C "$MAIN" merge --ff-only "origin/$BASE"; then
    echo "error: could not synchronize '$BASE'; resolve remote connectivity or divergence, then retry finish. Phase worktree retained." >&2
    exit 1
  fi
fi

# ── pre-merge check hook (repo-specific validations) ─────────────────────────
# Runs after the sync so it sees the freshest $BASE; nonzero exit aborts with
# nothing merged. No-op in repos without the script.
PREMERGE=$(gsd_conf_get "$MAIN" premerge)
PREMERGE="${PREMERGE:-scripts/gsd-premerge-check.sh}"
case "$PREMERGE" in /*) PREMERGE_PATH="$PREMERGE" ;; *) PREMERGE_PATH="$MAIN/$PREMERGE" ;; esac
validate_finish() { # checkout whose code will be validated; before/after merge
local validation_dir=$1 stage=$2
if [ "$PREMERGE" != none ] && [ -x "$PREMERGE_PATH" ]; then
  echo "▶ pre-merge check ($PREMERGE)…"
  if ! ( cd "$MAIN" && "$PREMERGE_PATH" "$BRANCH" "$BASE" ); then
    echo "✗ validation failed ($stage) — not pushing or removing the phase worktree." >&2
    return 1
  fi
elif TEST_CMD=$(gsd_test_cmd "$MAIN") && [ -n "$TEST_CMD" ]; then
  # No repo-authored check: fall back to the project's test suite, run in the
  # worktree (that is where the phase's code and node_modules are). `test =`
  # in .gsd.conf overrides the detection; 'none' skips.
  echo "▶ tests ($TEST_CMD, in $validation_dir; $stage)…"
  if ! ( cd "$validation_dir" && $TEST_CMD ); then
    echo "✗ tests failed ($stage) — not pushing or removing the phase worktree. Any merge remains local." >&2
    echo "  (skip with 'test = none' in .gsd.conf, or provide $PREMERGE)" >&2
    return 1
  fi
fi
}
validate_finish "$DEST" 'before merge'

echo "▶ merging '$BRANCH' into '$BASE'…"
if ! git -C "$MAIN" merge --no-ff "$BRANCH" -m "Merge $BRANCH into $BASE"; then
  conflicts=$(git -C "$MAIN" diff --name-only --diff-filter=U | tr '\n' ' ')
  git -C "$MAIN" merge --abort 2>/dev/null || true
  echo "✗ merge conflict with '$BASE' — aborted, '$BASE' left clean. Conflicts: ${conflicts:-?}" >&2
  echo "  Resolve in the worktree: git -C $DEST merge $BASE, fix conflicts, commit, then re-run finish." >&2
  exit 1
fi
repair_planning "the phase merge"
validate_finish "$MAIN" 'combined tree after phase merge'

if [ "$HAS_ORIGIN" = 1 ]; then
  echo "▶ pushing '$BASE'…"
  pushed=0
  for _try in 1 2 3; do
    if git -C "$MAIN" push origin "$BASE" --quiet; then pushed=1; break; fi
    echo "  push rejected (parallel session moved '$BASE') — merging origin/$BASE and retrying…"
    if ! git -C "$MAIN" pull --no-rebase --no-edit origin "$BASE"; then
      conflicts=$(git -C "$MAIN" diff --name-only --diff-filter=U | tr '\n' ' ')
      git -C "$MAIN" merge --abort 2>/dev/null || true
      echo "✗ conflict syncing with origin/$BASE — aborted, '$BASE' left clean. Conflicts: ${conflicts:-?}" >&2
      echo "  Resolve manually: git -C $MAIN pull --no-rebase origin $BASE, fix, commit, push — then re-run finish to clean up." >&2
      exit 1
    fi
    # This pull is the divergence case union handles worst — another session
    # moved the base branch under us — so reconcile before retrying the push.
    repair_planning "the origin/$BASE sync"
    validate_finish "$MAIN" 'combined tree after remote retry'
  done
  if [ "$pushed" != 1 ]; then
    echo "✗ could not push '$BASE' after 3 attempts — push manually, then re-run to clean up." >&2
    exit 1
  fi
else
  echo "• no 'origin' remote — skipping push"
fi

echo "▶ removing worktree + branch…"
if [ -d "$DEST" ]; then
  git -C "$MAIN" worktree remove "$DEST"
else
  echo "• worktree already removed — cleaning up the branch only"
  git -C "$MAIN" worktree prune
fi
git -C "$MAIN" branch -d "$BRANCH"

echo "✅ '$BRANCH' merged into '$BASE', pushed, and cleaned up."
