#!/usr/bin/env bash
#
# gsd-doctor — read-only health check of a repo's GSD setup.
#
# Diagnoses; never fixes. Every finding names the command that fixes it, and you
# run that yourself. There is deliberately no --fix: a command that writes
# broadly is exactly what this toolkit does not want — the writes belong to
# gsd-init (repo setup) and gsd-planning-repair (planning state), which are
# scoped and reviewable. Being read-only is also what makes it safe to run
# anywhere, any time, including on a repo you are mid-feature in.
#
# Nothing here writes: no fetch, no config, no files. Comparisons against origin
# therefore use the refs from your last fetch and are marked as such.
#
# Usage:
#   gsd-doctor [--repo <path>] [--quiet] [--json]
#
# Options:
#   --repo <path>  repo to inspect (default: the checkout containing cwd)
#   --quiet        print findings only, not the checks that passed
#   --json         machine output: {"repo","findings":[{code,message,fix}],"count"}
#                  Codes shared with gsd-core's /gsd-health where they mean the
#                  same thing (W017 orphan branch, W027 stale worktree record);
#                  toolkit-only findings use T0xx.
#                  T040 = a merged phase skipped a mandatory flow step (only
#                  in repos with `flow = strict`; `flow_since = <N>` in .gsd.conf
#                  limits it to phases >= N).
#   -h, --help     show this help
#
# Exit status: 0 when everything checks out, 1 when there is a finding.
#
# RELATED
#   gsd-init             fixes repo-setup findings (re-run: it is idempotent)
#   gsd-planning-repair  fixes planning-state findings
#   gsd-sync             fixes toolkit findings
set -uo pipefail

die() { printf '✖ %s\n' "$@" >&2; exit 1; }

usage() { awk 'NR>1 && /^set -uo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"; }

SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh"

REPO=""
QUIET=0
JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --repo) [ $# -ge 2 ] || die "--repo needs a value"; REPO="$2"; shift 2 ;;
    --quiet|-q) QUIET=1; shift ;;
    --json) JSON=1; QUIET=1; shift ;;
    *) die "unknown argument: $1 (see gsd-doctor --help)" ;;
  esac
done

if [ -z "$REPO" ]; then
  REPO="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || die "not inside a git repository — pass --repo <path>"
fi
MAIN="$(gsd_main "$REPO")"
[ -n "$MAIN" ] || die "not a git repository: $REPO"

FINDINGS=0
FIXES=""        # the distinct commands to run, ONE PER LINE, in the order first needed
pass() { [ "$QUIET" = 1 ] || printf '  \033[32m✔\033[0m %s\n' "$1"; }
note() { [ "$QUIET" = 1 ] || printf '  • %s\n' "$1"; }
JSON_ITEMS=""
jstr() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\033' ; }
fail() {  # $1=what is wrong  $2=the command that fixes it (short — no `cd`)  $3=code
  FINDINGS=$((FINDINGS + 1))
  if [ "$JSON" = 1 ]; then
    JSON_ITEMS="${JSON_ITEMS:+$JSON_ITEMS,}{\"code\":\"${3:-T000}\",\"message\":\"$(jstr "$1")\",\"fix\":\"$(jstr "$2")\"}"
    return 0
  fi
  printf '  \033[31m✖\033[0m %s \033[2m→ %s [%s]\033[0m\n' "$1" "$2" "${3:-T000}"
  # Collect for the summary. Repeating a long `cd … && …` on every line pushes
  # the command off the right edge and reads as noise; the summary says it once.
  # Newline-separated: fixes are commands WITH spaces ('rm -rf …'), so a
  # space-joined list would shred them at print time.
  printf '%s\n' "$FIXES" | grep -qxF -- "$2" || FIXES="${FIXES:+$FIXES$'\n'}$2"
}
section() { [ "$QUIET" = 1 ] || printf '\n\033[1m%s\033[0m\n' "$1"; }

[ "$JSON" = 1 ] || printf '\033[1mgsd-doctor\033[0m — %s\n%s\n' "$(basename "$MAIN")" "$MAIN"

# ── toolkit ──────────────────────────────────────────────────────────────────
section "toolkit"

resolved=""
if live="$(command -v gsd-finish 2>/dev/null)"; then
  while [ -L "$live" ]; do
    t=$(readlink "$live")
    case "$t" in /*) live="$t" ;; *) live="$(dirname "$live")/$t" ;; esac
  done
  resolved="$(cd "$(dirname "$live")/.." 2>/dev/null && pwd)"
fi
if [ -z "$resolved" ]; then
  fail "gsd commands are not on PATH" "(cd $GSD_PKG && ./install.sh)" "T001"
elif [ "$resolved" != "$GSD_PKG" ]; then
  fail "PATH commands come from $resolved, not this package" "(cd $GSD_PKG && ./install.sh)" "T002"
else
  pass "PATH commands resolve to $GSD_PKG"
fi

if PY=$(gsd_python); then
  pass "$PY $("$PY" --version 2>&1 | awk '{print $2}') (the planning repair needs it)"
else
  fail "no python 3.7+ (tried python3, then python) — planning merges fall back to plain union" "install python3" "T003"
fi

# GSD itself: is a newer release on npm? A note, never a finding — the parsers
# in lib/ track the installed version, and upgrading is the user's call.
if command -v gsd-sdk >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
  have=$(gsd-sdk -v 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  want=$(npm view get-shit-done-cc dist-tags.latest --fetch-retries=0 --fetch-timeout=5000 2>/dev/null || true)
  if [ -z "$have" ] || [ -z "$want" ]; then
    note "gsd-sdk ${have:-?} installed (npm not reachable — latest unknown)"
  elif [ "$have" = "$want" ]; then
    pass "gsd-sdk $have is the latest on npm"
  elif [ "$(printf '%s\n%s\n' "$have" "$want" | sort -V | tail -1)" = "$want" ]; then
    note "gsd-sdk $have installed, $want on npm — npm i -g get-shit-done-cc@latest (then re-check gsd-list/gsd-planning-repair)"
  else
    note "gsd-sdk $have installed, ahead of npm latest ($want)"
  fi
fi

# Notes, not findings: these are about the toolkit checkout, not the repo you
# asked about. Nothing here is broken — you would just lose local edits. Only
# toolkit problems that actually stop things working (no commands on PATH, no
# python3) count against the repo you are inspecting.
if [ -n "$(git -C "$GSD_PKG" status --porcelain 2>/dev/null)" ]; then
  note "toolkit has uncommitted changes ($GSD_PKG)"
fi
if git -C "$GSD_PKG" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
  ahead=$(git -C "$GSD_PKG" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
  [ "$ahead" -gt 0 ] && note "toolkit has $ahead unpushed commit(s) — gsd-sync pushes them"
fi

# ── is this even a GSD repo? ─────────────────────────────────────────────────
# Without this, every repo that has nothing to do with GSD gets four red lines
# telling it to install GSD — including this toolkit, which is the SOURCE of
# the scripts and is deliberately not a GSD project. gsd-bootstrap-repo already
# refuses to run here; doctor has to know the same thing.
if [ -f "$GSD_PKG/install.sh" ] && [ -d "$GSD_PKG/shims" ] && [ "$MAIN" = "$GSD_PKG" ]; then
  section "repo setup"
  note "this is the gsd-worktrees toolkit itself, not a GSD project — setup checks skipped"
  IS_GSD_REPO=0
elif [ -d "$MAIN/.planning" ] || [ -f "$MAIN/.gsd.conf" ] \
     || [ -f "$MAIN/scripts/gsd-finish-worktree-feature.sh" ]; then
  IS_GSD_REPO=1
else
  section "repo setup"
  note "no .planning/, no .gsd.conf, no gsd shims — this repo does not use GSD"
  note "set it up with:  cd $MAIN && gsd-init"
  IS_GSD_REPO=0
fi

# ── repo setup (fixed by re-running gsd-init) ────────────────────────────────
if [ "$IS_GSD_REPO" = 1 ]; then
section "repo setup"

[ -f "$MAIN/.gsd.conf" ] \
  && pass ".gsd.conf (base $(gsd_base "$MAIN"), worktrees $(gsd_wtdir "$MAIN"))" \
  || note "no .gsd.conf — settings are auto-detected (base $(gsd_base "$MAIN"))"

drift=0
missing=0
while IFS= read -r rel; do
  [ -n "$rel" ] || continue
  if [ ! -f "$MAIN/$rel" ]; then missing=$((missing + 1))
  elif ! cmp -s "$GSD_PKG/shims/$rel" "$MAIN/$rel"; then drift=$((drift + 1)); fi
done < <( cd "$GSD_PKG/shims" && find scripts -type f -name 'gsd-*' ! -name '*.example' 2>/dev/null )
if [ "$missing" -gt 0 ] || [ "$drift" -gt 0 ]; then
  fail "shims: $missing missing, $drift out of date" "gsd-init" "T010"
else
  pass "shims present and current"
fi

# The three merge-safety items, from the same predicate gsd-bootstrap-repo
# applies — one source of truth for what "installed" means.
gsd_planning_status "$MAIN"
case " $GSD_PLANNING_MISSING " in
  *" attributes "*)
    [ "$GSD_ATTRS_STATE" = union ] \
      && fail ".gitattributes still on merge=union (keeps BOTH sides)" "gsd-init" "T011" \
      || fail ".gitattributes missing the .planning merge rules" "gsd-init" "T012" ;;
  *) pass ".gitattributes: merge=gsd-planning on ROADMAP.md + STATE.md" ;;
esac
case " $GSD_PLANNING_MISSING " in
  # Not versioned, so a fresh clone always lacks it. gsd-finish re-asserts it,
  # so this is a finding rather than an emergency.
  *" driver "*) fail "merge driver not registered (per-clone; git config is not versioned)" "gsd-init" "T013" ;;
  *) pass "merge driver registered in git config" ;;
esac
case " $GSD_PLANNING_MISSING " in
  *" hook "*) fail "no post-merge hook — a plain 'git pull' is unguarded" "gsd-init" "T014" ;;
  *) pass "post-merge hook reconciles .planning after a plain git pull" ;;
esac

if grep -q 'gsd-worktree-guard' "$MAIN/.claude/settings.json" 2>/dev/null; then
  pass "guard hook registered in .claude/settings.json"
else
  note "guard hook not registered (Claude Code only; harmless under other agents)"
fi
fi  # IS_GSD_REPO

# ── planning state (fixed by gsd-planning-repair) ────────────────────────────
if [ "$IS_GSD_REPO" = 1 ]; then
section "planning state"

if [ ! -d "$MAIN/.planning" ]; then
  note "no .planning/ — this repo has no GSD planning state yet"
elif [ -d "$MAIN/.planning/workstreams" ] && [ -n "$(ls -A "$MAIN/.planning/workstreams" 2>/dev/null)" ]; then
  # gsd-core's /gsd-workstreams routes ROADMAP/STATE under
  # .planning/workstreams/<name>/. Every command in this toolkit reads the
  # top-level .planning/ROADMAP.md, so gsd-start/gsd-list/gsd-planning-repair
  # would silently claim, list and repair the wrong roadmap. Loud, not quiet.
  fail "gsd-core workstreams in use (.planning/workstreams/) — this toolkit only reads the top-level .planning/ and is not workstream-aware" \
       "/gsd-workstreams complete <name>, or drive those phases without gsd-start" "T024"
elif ! command -v gsd-planning-repair >/dev/null 2>&1; then
  fail "gsd-planning-repair not on PATH — cannot check .planning" "(cd $GSD_PKG && ./install.sh)" "T004"
else
  out="$(gsd-planning-repair --repo "$MAIN" --check 2>&1)"; rc=$?
  case "$rc" in
    0) pass ".planning is coherent"
       printf '%s\n' "$out" | grep -E '^  - ' | while IFS= read -r l; do note "${l#  - }"; done ;;
    1) fail ".planning contradicts itself (union-merge damage)" "gsd-planning-repair" "T020"
       printf '%s\n' "$out" | grep -E '^  • ' | sed 's/^  •/      ·/' ;;
    *) note ".planning has no ROADMAP.md — nothing to check" ;;
  esac
fi

# Phase-checkbox bookkeeping. Upstream's phase.insert skips the checklist and
# Progress rows, and phase.complete's tick regex is greedy — both fail without
# saying so, which is exactly why this belongs in a health check. See
# lib/roadmap-audit.pl for the mechanics.
# Scoped to the checkout you are STANDING IN, not $MAIN — unlike every other
# check here. Each worktree carries its own .planning/ROADMAP.md (its branch's
# version), and the branch is where phase.complete will actually run. Auditing
# $MAIN from inside a worktree reports the phase's roadmap clean while the
# branch's own copy is broken, which is worse than not checking at all.
HERE="$(git -C "$REPO" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$MAIN")"
[ -f "$HERE/.planning/ROADMAP.md" ] || HERE="$MAIN"
ROADMAP="$HERE/.planning/ROADMAP.md"

# The branch is named ONCE, above the findings — repeating it on every line is
# the same right-edge noise the fix-summary avoids.
BR=""; EDIT="edit .planning/ROADMAP.md"
if [ "$HERE" != "$MAIN" ]; then
  BR="$(git -C "$HERE" branch --show-current 2>/dev/null)"
  BR="${BR:-$(basename "$HERE")}"
  EDIT="edit .planning/ROADMAP.md in $(basename "$HERE")"
fi

if [ -f "$ROADMAP" ] && [ -f "$GSD_PKG/lib/roadmap-audit.pl" ]; then
  audit="$(perl "$GSD_PKG/lib/roadmap-audit.pl" "$ROADMAP" 2>/dev/null)"
  [ -z "$BR" ] || note "roadmap checked on '$BR' (this worktree's own copy, not $(gsd_base "$MAIN")'s)"
  if [ -z "$audit" ]; then
    pass "roadmap: every phase has its rows and ticks its own checkbox"
  else
    while IFS='|' read -r kind a b; do
      [ -n "$kind" ] || continue
      case "$kind" in
        TICK)   fail "completing Phase $a would tick the wrong row: $b" "$EDIT" "T021" ;;
        NOROW)  fail "Phase $a has no checklist row — completing it ticks nothing, silently" "$EDIT" "T022" ;;
        NOPROG) fail "Phase $a is missing from the Progress table" "$EDIT" "T023" ;;
      esac
    done <<EOF
$audit
EOF
    note "cross-references in a checklist row must read 'phase-13', never 'Phase 13'"
    [ -z "$BR" ] || note "these may all clear with:  git merge $(gsd_base "$MAIN")"
  fi
fi
# ── phase flow (opt-in: flow = strict) ──────────────────────────────────────
# Which MERGED phases skipped a mandatory step. Same artifact list the guard's
# flow rule and a repo's pre-merge gate enforce going forward; this is the
# backlog view over phases finished before those gates existed. Scoped to
# $MAIN (merged = on the base branch). `flow_since = <N>` in .gsd.conf limits
# it to phases >= N — older phases predate the rules and would only be noise.
if [ "$(gsd_conf_get "$MAIN" flow)" = "strict" ] && [ -f "$MAIN/.planning/ROADMAP.md" ]; then
  section "phase flow (flow = strict)"
  SINCE="$(gsd_conf_get "$MAIN" flow_since)"; SINCE="${SINCE:-0}"
  flow_has() { [ -f "$pd/$p-$1" ]; }
  debt=0; checked=0
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    awk -v a="$n" -v b="$SINCE" 'BEGIN{exit !(a+0 >= b+0)}' || continue
    case "$n" in *.*) p="$n" ;; *) p=$(printf '%02d' "$n") ;; esac
    pd=""; for d in "$MAIN/.planning/phases/$p"-*; do [ -d "$d" ] && { pd="$d"; break; }; done
    [ -n "$pd" ] || { note "Phase $n: no .planning/phases/$p-* directory (archived?) — skipped"; continue; }
    checked=$((checked + 1)); miss=""; fix=""
    # Only steps that still have an action AFTER the merge. Discuss and the
    # cross-AI plan review shape the plan; redoing them on built code changes
    # nothing (plan-phase --reviews refuses closed phases). The guard and the
    # pre-merge gate hold those going forward.
    if ! flow_has STORY.md; then case "$pd" in *cu_*) ;; *) miss="$miss story"; fix="$fix ClickUp story → $p-STORY.md;" ;; esac; fi
    flow_has REVIEW.md       || { miss="$miss code-review";     fix="$fix /gsd-code-review $n;"; }
    if flow_has SECURITY.md; then
      open=$(sed -n '/^---$/,/^---$/p' "$pd/$p-SECURITY.md" | sed -n 's/^threats_open:[[:space:]]*//p' | head -1 | tr -d '[:space:]')
      [ "${open:-0}" = 0 ] || { miss="$miss security($open-open)"; fix="$fix /gsd-secure-phase $n;"; }
    else miss="$miss secure-phase"; fix="$fix /gsd-secure-phase $n;"; fi
    flow_has VERIFICATION.md || { miss="$miss verifier";        fix="$fix /gsd-execute-phase $n (runs the verifier);"; }
    ls "$pd/$p"-*UAT.md >/dev/null 2>&1 || { miss="$miss verify-work"; fix="$fix /gsd-verify-work $n;"; }
    if flow_has UI-SPEC.md && ! flow_has UI-REVIEW.md; then miss="$miss ui-review"; fix="$fix /gsd-ui-review $n;"; fi
    if [ -n "$miss" ]; then
      debt=$((debt + 1))
      fail "Phase $n merged without:$miss" "in a phase-$n worktree:${fix%;}" "T040"
    fi
  done < <(sed -n -E 's/^- \[x\] \*\*Phase ([0-9]+(\.[0-9]+)?):.*/\1/p' "$MAIN/.planning/ROADMAP.md")
  [ "$debt" -eq 0 ] && pass "every merged phase since $SINCE carries its mandatory artifacts ($checked checked)"
fi
fi  # IS_GSD_REPO

# ── worktree hygiene ─────────────────────────────────────────────────────────
# Worth checking anywhere: stale locks and orphaned phase branches are about
# git state, not about whether the repo opted into GSD.
section "worktrees"

LOCK="$MAIN/.git/gsd-cmd.lock"
if [ -d "$LOCK" ]; then
  pid="$(cat "$LOCK/pid" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    note "a gsd command is running right now (pid $pid)"
  else
    fail "stale command lock from a crashed run (pid ${pid:-?})" "rm -rf .git/gsd-cmd.lock" "T030"
  fi
fi

gone=0
live_branches=""
while IFS= read -r line; do
  case "$line" in
    "worktree "*) wt="${line#worktree }"; [ -d "$wt" ] || gone=$((gone + 1)) ;;
    "branch "*)   live_branches="$live_branches ${line#branch refs/heads/}" ;;
  esac
done < <(git -C "$MAIN" worktree list --porcelain 2>/dev/null)
[ "$gone" -gt 0 ] \
  && fail "$gone worktree(s) recorded but missing on disk" "git worktree prune" "W027" \
  || pass "no stale worktree records"

orphans=""
while IFS= read -r br; do
  [ -n "$br" ] || continue
  case " $live_branches " in *" $br "*) continue ;; esac
  orphans="$orphans $br"
done < <(git -C "$MAIN" for-each-ref --format='%(refname:short)' 'refs/heads/phase-*' 2>/dev/null)
if [ -n "$orphans" ]; then
  fail "phase branch(es) with no worktree:$orphans" "gsd-finish <N>, or git branch -d" "W017"
else
  pass "every phase branch has its worktree"
fi

# Branches whose upstream was deleted (a merged PR, a gsd-finish run from
# another machine). Read from the last fetch — no fetch here, by design.
gone_up=$(git -C "$MAIN" for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads 2>/dev/null \
            | awk '$2=="[gone]"{print $1}' | tr '\n' ' ')
[ -z "$gone_up" ] || note "branch(es) whose upstream is gone: ${gone_up}— git fetch --prune && git branch -d <name>"

BASE="$(gsd_base "$MAIN")"
cur="$(git -C "$MAIN" branch --show-current 2>/dev/null)"
[ "$cur" = "$BASE" ] \
  && pass "main checkout is on '$BASE'" \
  || fail "main checkout is on '$cur', not '$BASE' (gsd-finish will refuse)" "git checkout $BASE" "T031"

if git -C "$MAIN" show-ref --verify --quiet "refs/remotes/origin/$BASE"; then
  behind=$(git -C "$MAIN" rev-list --count "$BASE..origin/$BASE" 2>/dev/null || echo 0)
  [ "${behind:-0}" -gt 0 ] \
    && note "'$BASE' is $behind commit(s) behind origin as of your last fetch (no fetch is done here)"
fi

# ── verdict ──────────────────────────────────────────────────────────────────
if [ "$JSON" = 1 ]; then
  printf '{"repo":"%s","count":%d,"findings":[%s]}\n' "$(jstr "$MAIN")" "$FINDINGS" "$JSON_ITEMS"
  [ "$FINDINGS" -eq 0 ]; exit $?
fi
echo ""
if [ "$FINDINGS" -eq 0 ]; then
  printf '\033[32m✔ no findings\033[0m\n'
  exit 0
fi
printf '\033[31m%d finding(s).\033[0m Run:\n\n' "$FINDINGS"
[ "$(git rev-parse --show-toplevel 2>/dev/null)" = "$MAIN" ] || printf '  cd %s\n' "$MAIN"
printf '%s\n' "$FIXES" | while IFS= read -r fix; do printf '  %s\n' "$fix"; done
echo ""
echo "(then re-run gsd-doctor to confirm)"
exit 1
