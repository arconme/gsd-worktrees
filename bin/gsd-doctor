#!/usr/bin/env bash
#
# gsd-doctor — read-only health check of a repo's GSD setup.
#
# Diagnoses; never fixes. Every finding names the command that fixes it, and you
# run that yourself. There is deliberately no --fix: a command that writes
# broadly is exactly what this toolkit does not want — the writes belong to
# gsd-init (repo setup) and gsd-planning-repair (planning state), which are
# scoped and reviewable. Being read-only is also what makes it safe to run
# anywhere, any time, including on a repo you are mid-feature in.
#
# Nothing here writes to your repos: no fetch, no git config, no files there.
# Comparisons against origin therefore use the refs from your last fetch and are
# marked as such. The one exception is the version check, which may ask GitHub
# and npm for the latest versions (at most once a day) and caches the answers
# in ~/.cache/gsd-worktrees/ (GSD_NO_UPDATE_CHECK=1 turns it off).
#
# Usage:
#   gsd-doctor [--repo <path>] [--quiet] [--json]
#
# Options:
#   --repo <path>  repo to inspect (default: the checkout containing cwd)
#   --quiet        print findings and available updates only, not the checks that passed
#   --json         machine output, one object: repo, gsd_repo (false = not a
#                  GSD repo, setup checks skipped), session_model, configured
#                  (provider list), provider {name, command, available,
#                  instruction_file, instruction_integrated, skill_installed,
#                  command_guard, native_hook}, count, findings [{code,message,fix}],
#                  updates [{name,installed,latest,fix}] (newer gsd-worktrees /
#                  GSD; shown with --quiet too, never a finding)
#                  Codes shared with gsd-core's /gsd-health where they mean the
#                  same thing (W017 orphan branch, W027 stale worktree record);
#                  toolkit-only findings use T0xx.
#                  T040 = a merged phase skipped a mandatory flow step (only
#                  in repos with `flow = strict`; `flow_since = <N>` in .gsd.conf
#                  limits it to phases >= N).
#                  T070–T073 = ticket tracker config (`tracker =` in .gsd.conf).
#   -h, --help     show this help
#
# Exit status: 0 when everything checks out, 1 when there is a finding.
#
# RELATED
#   gsd-init             fixes repo-setup findings (re-run: it is idempotent)
#   gsd-planning-repair  fixes planning-state findings
#   gsd-update           fixes toolkit findings (release install)
#   gsd-sync             fixes toolkit findings (git-checkout install)
set -uo pipefail

die() { printf '✖ %s\n' "$@" >&2; exit 1; }

usage() { awk 'NR>1 && /^set -uo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"; }

SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh"
. "$GSD_PKG/lib/provider.sh"
# shellcheck source=../lib/tracker.sh
. "$GSD_PKG/lib/tracker.sh"
# shellcheck source=../lib/version.sh
. "$GSD_PKG/lib/version.sh"

REPO=""
QUIET=0
JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --repo) [ $# -ge 2 ] || die "--repo needs a value"; REPO="$2"; shift 2 ;;
    --quiet|-q) QUIET=1; shift ;;
    --json) JSON=1; QUIET=1; shift ;;
    *) die "unknown argument: $1 (see gsd-doctor --help)" ;;
  esac
done

if [ -z "$REPO" ]; then
  REPO="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || die "not inside a git repository — pass --repo <path>"
fi
MAIN="$(gsd_main "$REPO")"
[ -n "$MAIN" ] || die "not a git repository: $REPO"

FINDINGS=0
FIXES=""        # the distinct commands to run, ONE PER LINE, in the order first needed
pass() { [ "$QUIET" = 1 ] || printf '  \033[32m✔\033[0m %s\n' "$1"; }
note() { [ "$QUIET" = 1 ] || printf '  • %s\n' "$1"; }
# A newer version: shown even with --quiet, listed under "updates" in --json,
# but not a finding (the exit status stays 0 — updating is the user's call).
UPDATES_JSON=""
update() {  # $1=name $2=installed $3=latest $4=command
  [ "$JSON" = 1 ] || printf '  \033[33m↑\033[0m %s %s installed, %s available — update: %s\n' "$1" "$2" "$3" "$4"
  UPDATES_JSON="${UPDATES_JSON:+$UPDATES_JSON,}{\"name\":\"$(jstr "$1")\",\"installed\":\"$(jstr "$2")\",\"latest\":\"$(jstr "$3")\",\"fix\":\"$(jstr "$4")\"}"
}
JSON_ITEMS=""
jstr() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\033' ; }
fail() {  # $1=what is wrong  $2=the command that fixes it (short — no `cd`)  $3=code
  FINDINGS=$((FINDINGS + 1))
  if [ "$JSON" = 1 ]; then
    JSON_ITEMS="${JSON_ITEMS:+$JSON_ITEMS,}{\"code\":\"${3:-T000}\",\"message\":\"$(jstr "$1")\",\"fix\":\"$(jstr "$2")\"}"
    return 0
  fi
  printf '  \033[31m✖\033[0m %s \033[2m→ %s [%s]\033[0m\n' "$1" "$2" "${3:-T000}"
  # Collect for the summary. Repeating a long `cd … && …` on every line pushes
  # the command off the right edge and reads as noise; the summary says it once.
  # Newline-separated: fixes are commands WITH spaces ('rm -rf …'), so a
  # space-joined list would shred them at print time.
  printf '%s\n' "$FIXES" | grep -qxF -- "$2" || FIXES="${FIXES:+$FIXES$'\n'}$2"
}
section() { [ "$QUIET" = 1 ] || printf '\n\033[1m%s\033[0m\n' "$1"; }

# How to (re)install THIS toolkit: a git checkout re-runs its install.sh; a
# release runtime re-runs its own get.sh for the same version.
if [ -e "$GSD_PKG/.git" ]; then
  REINSTALL="$GSD_PKG/install.sh --reuse-install-config"
elif [ -f "$GSD_PKG/get.sh" ]; then
  REINSTALL="bash $GSD_PKG/get.sh --version $(gsd_version) --reuse-install-config"
else
  REINSTALL="curl -fsSL https://raw.githubusercontent.com/$(gsd_update_repo)/main/get.sh | bash -s --"
fi

RAW_PROVIDERS=$(gsd_conf_get "$MAIN" providers)
RAW_LEGACY_PROVIDER=$(gsd_conf_get "$MAIN" provider)
if [ -n "$RAW_PROVIDERS" ]; then RAW_PROVIDER=${RAW_PROVIDERS%%,*}
else RAW_PROVIDER=${RAW_LEGACY_PROVIDER:-claude}
fi
RAW_COMMAND=$(gsd_conf_get "$MAIN" agent_command)
PROVIDER_VALID=1
if gsd_provider_resolve "$MAIN" "$RAW_PROVIDER" "" 2>/dev/null; then
  DOCTOR_PROVIDER=$GSD_PROVIDER_RESOLVED; DOCTOR_COMMAND=$GSD_AGENT_COMMAND_RESOLVED
else
  PROVIDER_VALID=0; DOCTOR_PROVIDER=$RAW_PROVIDER; DOCTOR_COMMAND=${RAW_COMMAND:-unknown}
fi
PROVIDER_AVAILABLE=false; command -v "$DOCTOR_COMMAND" >/dev/null 2>&1 && PROVIDER_AVAILABLE=true
DOCTOR_MODEL=""; MODEL_VALID=1
if gsd_model_resolve "$MAIN" "$DOCTOR_PROVIDER" "" 2>/dev/null; then
  DOCTOR_MODEL=$GSD_MODEL_RESOLVED
else MODEL_VALID=0
fi

[ "$JSON" = 1 ] || printf '\033[1mgsd-doctor\033[0m — %s\n%s\n' "$(basename "$MAIN")" "$MAIN"

# ── toolkit ──────────────────────────────────────────────────────────────────
section "toolkit"

resolved=""
if live="$(command -v gsd-finish 2>/dev/null)"; then
  while [ -L "$live" ]; do
    t=$(readlink "$live")
    case "$t" in /*) live="$t" ;; *) live="$(dirname "$live")/$t" ;; esac
  done
  resolved="$(cd "$(dirname "$live")/.." 2>/dev/null && pwd)"
fi
if [ -z "$resolved" ]; then
  fail "gsd commands are not on PATH" "$REINSTALL" "T001"
elif [ "$resolved" != "$GSD_PKG" ]; then
  fail "PATH commands come from $resolved, not this package" "$REINSTALL" "T002"
else
  pass "PATH commands resolve to $GSD_PKG"
fi

if PY=$(gsd_python); then
  pass "$PY $("$PY" --version 2>&1 | awk '{print $2}') (the planning repair needs it)"
else
  fail "no python 3.7+ (tried python3, then python) — planning merges fall back to plain union" "install python3" "T003"
fi
if command -v perl >/dev/null 2>&1; then
  pass "perl (claims add roadmap rows; the roadmap check needs it)"
else
  fail "perl not found — claims cannot add roadmap rows and the roadmap check is skipped" "install perl" "T006"
fi
if ! command -v gsd-sdk >/dev/null 2>&1; then
  fail "gsd-sdk not on PATH (GSD not installed?) — gsd-start cannot claim phases" "$GSD_GSD_UPDATE_CMD" "T005"
fi

# This toolkit: a newer release on GitHub? A note, never a finding. Uses the
# day-old cache (lib/version.sh) and refreshes it when stale.
if [ -z "${GSD_NO_UPDATE_CHECK:-}" ]; then
  gsd_latest_stale && gsd_latest_refresh
  tk_new=$(gsd_latest_cached); tk_cur=$(gsd_version)
  if [ -n "$tk_new" ] && gsd_version_gt "$tk_new" "$tk_cur"; then
    update gsd-worktrees "$tk_cur" "$tk_new" "$(gsd_update_how)"
  elif [ -n "$tk_new" ]; then
    pass "gsd-worktrees $tk_cur (latest release: $tk_new)"
  else
    note "gsd-worktrees $tk_cur (latest release unknown — GitHub not reachable)"
  fi
fi

# GSD itself: is a newer release on npm? A note, never a finding — the parsers
# in lib/ track the installed version, and upgrading is the user's call.
if [ -z "${GSD_NO_UPDATE_CHECK:-}" ] && command -v gsd-sdk >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
  have=$(gsd_gsd_installed)
  gsd_gsd_stale && gsd_gsd_refresh; want=$(gsd_gsd_cached)
  if [ -z "$have" ] || [ -z "$want" ]; then
    note "gsd-sdk ${have:-?} installed (npm not reachable — latest unknown)"
  elif [ "$have" = "$want" ]; then
    pass "gsd-sdk $have is the latest on npm"
  elif gsd_version_gt "$want" "$have"; then
    update GSD "$have" "$want" "$GSD_GSD_UPDATE_CMD (then re-check gsd-list/gsd-planning-repair)"
  else
    note "gsd-sdk $have installed, ahead of npm latest ($want)"
  fi
fi

# Notes, not findings: these are about the toolkit checkout, not the repo you
# asked about. Nothing here is broken — you would just lose local edits. Only
# toolkit problems that actually stop things working (no commands on PATH, no
# python3) count against the repo you are inspecting.
if [ -n "$(git -C "$GSD_PKG" status --porcelain 2>/dev/null)" ]; then
  note "toolkit has uncommitted changes ($GSD_PKG)"
fi
if git -C "$GSD_PKG" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
  ahead=$(git -C "$GSD_PKG" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
  [ "$ahead" -gt 0 ] && note "toolkit has $ahead unpushed commit(s) — gsd-sync pushes them"
fi

# ── is this even a GSD repo? ─────────────────────────────────────────────────
# Without this, every repo that has nothing to do with GSD gets four red lines
# telling it to install GSD — including this toolkit, which is the SOURCE of
# the scripts and is deliberately not a GSD project. gsd-bootstrap-repo already
# refuses to run here; doctor has to know the same thing.
# Resolve both sides through Git: the running toolkit may itself be a linked
# worktree, while MAIN always names the target repository's main checkout.
TOOLKIT_MAIN=$(gsd_main "$GSD_PKG")
if [ -f "$GSD_PKG/install.sh" ] && [ -d "$GSD_PKG/shims" ] && [ "$MAIN" = "$TOOLKIT_MAIN" ]; then
  section "repo setup"
  note "this is the gsd-worktrees toolkit itself, not a GSD project — setup checks skipped"
  IS_GSD_REPO=0
elif [ -d "$MAIN/.planning" ] || [ -f "$MAIN/.gsd.conf" ] \
     || [ -f "$MAIN/scripts/gsd-finish-worktree-feature.sh" ]; then
  IS_GSD_REPO=1
else
  section "repo setup"
  note "no .planning/, no .gsd.conf, no gsd shims — this repo does not use GSD"
  note "set it up with:  cd $MAIN && gsd-init"
  IS_GSD_REPO=0
fi

# ── repo setup (fixed by re-running gsd-init) ────────────────────────────────
if [ "$IS_GSD_REPO" = 1 ]; then
section "repo setup"
review_provider=$(gsd_conf_get "$MAIN" review_provider)
if [ -n "$review_provider" ] && ! gsd_provider_known "$review_provider"; then
  fail "invalid review_provider '$review_provider'" "set review_provider to claude, codex, gemini, or custom in .gsd.conf" "T060"
fi

if [ "$MODEL_VALID" = 0 ]; then
  fail "invalid model configuration for $DOCTOR_PROVIDER" "check ${DOCTOR_PROVIDER}_model in .gsd.conf and GSD model environment overrides" "T059"
else
  pass "session model: ${DOCTOR_MODEL:-CLI default} (model availability is checked by the provider CLI)"
fi
if [ "$PROVIDER_VALID" = 0 ]; then
  fail "invalid provider configuration: '$RAW_PROVIDER'" "edit .gsd.conf: providers = claude|codex|gemini|custom" "T050"
else
  pass "provider: $DOCTOR_PROVIDER (command: $DOCTOR_COMMAND)"
  [ "$PROVIDER_AVAILABLE" = true ] && pass "provider executable is available" || fail "provider executable '$DOCTOR_COMMAND' is unavailable (print-only still works)" "install $DOCTOR_COMMAND or set ${DOCTOR_PROVIDER}_command in .gsd.conf" "T051"
  instruction=$(gsd_provider_instruction_file "$DOCTOR_PROVIDER")
  if gsd_provider_instruction_integrated "$MAIN" "$DOCTOR_PROVIDER"; then pass "$instruction points to canonical .gsd/INSTRUCTIONS.md"; else fail "$instruction integration is missing, malformed or legacy" "gsd-init --no-launch" "T052"; fi
  hookstate=$(gsd_provider_hook_state "$MAIN" "$DOCTOR_PROVIDER")
  case "$hookstate" in
    unsupported) note "$DOCTOR_PROVIDER native hook unsupported; command-level guard is the enforcement path" ;;
    present) pass "$DOCTOR_PROVIDER native guard hook present (defense in depth)" ;;
    *) note "$DOCTOR_PROVIDER native hook $hookstate — inspect provider settings, then gsd-init --no-launch" ;;
  esac
  if gsd_command_guards_active "$GSD_PKG"; then pass "mandatory command-level guards are active"; else fail "mandatory command-level guard route is incomplete" "$REINSTALL" "T053"; fi
fi

configured=",${RAW_PROVIDERS:-${RAW_LEGACY_PROVIDER:-$DOCTOR_PROVIDER}},"
configured_list=${configured#,}; configured_list=${configured_list%,}
if [ -n "$RAW_LEGACY_PROVIDER" ]; then
  if [ -n "$RAW_PROVIDERS" ] && [ "$RAW_LEGACY_PROVIDER" != "${RAW_PROVIDERS%%,*}" ]; then
    fail "legacy provider '$RAW_LEGACY_PROVIDER' conflicts with providers default '${RAW_PROVIDERS%%,*}' and is ignored" "gsd-init --providers $configured_list --no-launch" "T056"
  else
    note "legacy 'provider' key is supported but redundant — gsd-init --providers $configured_list --no-launch migrates it"
  fi
fi
oldifs=$IFS; IFS=,
for configured_provider in $configured_list; do
  if ! gsd_provider_known "$configured_provider"; then fail "unknown configured provider '$configured_provider'" "edit .gsd.conf providers" "T050"; continue; fi
  if gsd_provider_resolve "$MAIN" "$configured_provider" "" 2>/dev/null; then
    if command -v "$GSD_AGENT_COMMAND_RESOLVED" >/dev/null 2>&1; then pass "configured provider $configured_provider is available as $GSD_AGENT_COMMAND_RESOLVED"
    else fail "configured provider $configured_provider executable '$GSD_AGENT_COMMAND_RESOLVED' is unavailable" "install it, set ${configured_provider}_command, or use print-only" "T057"; fi
  else fail "configured provider $configured_provider command is invalid" "check ${configured_provider}_command in .gsd.conf" "T050"; fi
  # Skills: installed, and the same as this toolkit's (a skill left from an
  # older install, or edited by hand, makes the agent follow old steps).
  skillroot=$(gsd_provider_skill_root "$configured_provider" 2>/dev/null || true)
  if [ -z "$skillroot" ]; then
    note "$configured_provider has no installable native skill format; follow .gsd/INSTRUCTIONS.md and gsd-flow-next"
  elif [ ! -f "$skillroot/gsd-flow/SKILL.md" ]; then
    note "$configured_provider skills not installed — $REINSTALL --agent $configured_provider"
  else
    stale_skills=""
    for sd in "$GSD_PKG"/skills/*/; do
      sn=$(basename "$sd")
      diff -qr -x .gsd-worktrees-skill "${sd%/}" "$skillroot/$sn" >/dev/null 2>&1 || stale_skills="$stale_skills $sn"
    done
    if [ -n "$stale_skills" ]; then
      fail "$configured_provider skills differ from this toolkit ($(gsd_version)):$stale_skills" "$REINSTALL --agent $configured_provider" "T007"
    else
      pass "$configured_provider skills installed and current ($skillroot)"
    fi
  fi
  configured_file=$(gsd_provider_instruction_file "$configured_provider")
  gsd_provider_instruction_integrated "$MAIN" "$configured_provider" || fail "$configured_provider instruction adapter is missing or malformed in $configured_file" "gsd-init --no-launch" "T058"
done
IFS=$oldifs
for f in CLAUDE.md AGENTS.md GEMINI.md; do
  gsd_owned_markers_valid "$MAIN/$f" provider || fail "mixed/malformed GSD instruction blocks in $f" "repair the owned marker pair, then gsd-init --no-launch" "T055"
  members=$(gsd_provider_instruction_members "$MAIN/$f")
  oldifs=$IFS; IFS=,
  for p in $members; do case "$configured" in *",$p,"*) ;; *) fail "stale $p provider block in $f" "remove only the stale provider's owned entrypoint, preserving shared providers and user content" "T054" ;; esac; done
  IFS=$oldifs
done

[ -f "$MAIN/.gsd.conf" ] \
  && pass ".gsd.conf (base $(gsd_base "$MAIN"), worktrees $(gsd_wtdir "$MAIN"))" \
  || note "no .gsd.conf — settings are auto-detected (base $(gsd_base "$MAIN"))"

# .gsd.conf: a misspelled key is silently ignored, so name it.
if [ -f "$MAIN/.gsd.conf" ]; then
  bad_keys=""; bad_lines=0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}; line=$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -n "$line" ] || continue
    case "$line" in *=*) ;; *) bad_lines=$((bad_lines + 1)); continue ;; esac
    key=$(printf '%s' "${line%%=*}" | sed 's/[[:space:]]*$//')
    case "$key" in
      base|wtdir|install|test|premerge|flow|flow_since|providers|provider|agent_command|review_provider|start_mode) ;;
      tracker|tracker_command|tracker_status_start|tracker_status_finish) ;;
      claude_command|codex_command|gemini_command|custom_command|claude_model|codex_model|gemini_model|custom_model) ;;
      *) bad_keys="$bad_keys $key" ;;
    esac
  done < "$MAIN/.gsd.conf"
  [ -z "$bad_keys" ] || fail "unknown .gsd.conf key(s):$bad_keys — ignored (typo?)" "edit .gsd.conf (valid keys: docs/providers.md)" "T017"
  [ "$bad_lines" = 0 ] || fail ".gsd.conf has $bad_lines line(s) that are not 'key = value' — ignored" "edit .gsd.conf" "T017"
  v=$(gsd_conf_get "$MAIN" flow)
  case "$v" in ''|strict|off|none) ;; *) fail "flow = '$v' is not a value (use strict, or remove it)" "edit .gsd.conf" "T018" ;; esac
  v=$(gsd_conf_get "$MAIN" flow_since)
  [ -z "$v" ] || printf '%s' "$v" | grep -qE '^[0-9]+(\.[0-9]+)?$' || fail "flow_since = '$v' is not a phase number" "edit .gsd.conf" "T018"
  v=$(gsd_conf_get "$MAIN" start_mode)
  case "$v" in ''|discuss|flow) ;; *) fail "start_mode = '$v' is not a value (use discuss or flow)" "edit .gsd.conf" "T018" ;; esac
fi

# The base branch every claim and finish works against.
BASE="$(gsd_base "$MAIN")"
if git -C "$MAIN" show-ref --verify --quiet "refs/heads/$BASE"; then :
elif git -C "$MAIN" show-ref --verify --quiet "refs/remotes/origin/$BASE"; then
  fail "base branch '$BASE' exists only on origin" "git branch --track $BASE origin/$BASE" "T015"
else
  fail "base branch '$BASE' does not exist — claims and finishes have nothing to work on" "create it, or set base = <branch> in .gsd.conf" "T015"
fi
git -C "$MAIN" remote get-url origin >/dev/null 2>&1 \
  || note "no 'origin' remote — claims and finishes stay local (fine on one machine; parallel sessions elsewhere won't see them)"

# The pre-merge gate: gsd-finish refuses a script it cannot run, and silently
# falls back to the tests when a configured path does not exist.
pm=$(gsd_conf_get "$MAIN" premerge)
if [ "$pm" != none ]; then
  pm_rel=${pm:-scripts/gsd-premerge-check.sh}
  case "$pm_rel" in /*) pm_abs=$pm_rel ;; *) pm_abs="$MAIN/$pm_rel" ;; esac
  if [ -e "$pm_abs" ] && [ ! -x "$pm_abs" ]; then
    fail "pre-merge script $pm_rel is not executable — gsd-finish will refuse" "chmod +x $pm_rel (and commit it)" "T019"
  elif [ -n "$pm" ] && [ ! -e "$pm_abs" ]; then
    fail "premerge = $pm, but that file does not exist — gsd-finish falls back to the tests" "fix premerge in .gsd.conf (or premerge = none)" "T019"
  elif [ -x "$pm_abs" ]; then
    pass "pre-merge gate: $pm_rel"
  fi
fi

# ── ticket tracker ───────────────────────────────────────────────────────────
TRACKER=$(gsd_tracker "$MAIN")
if ! gsd_tracker_known "$TRACKER"; then
  fail "unknown tracker '$TRACKER'" "set tracker = none, clickup, or custom in .gsd.conf" "T071"
elif [ "$TRACKER" = custom ]; then
  tc=$(gsd_tracker_command "$MAIN")
  if [ -n "$tc" ] && [ -x "$tc" ]; then pass "tracker: custom ($tc)"
  else fail "tracker = custom but tracker_command '${tc:-<unset>}' is not an executable file" "set tracker_command = <script> in .gsd.conf and chmod +x it (see docs/trackers.md)" "T072"; fi
elif [ "$TRACKER" = clickup ]; then
  cu_cfg="${GSD_CLICKUP_CONFIG:-$HOME/.config/gsd/clickup.env}"
  if [ -n "${CLICKUP_API_TOKEN:-}" ] || grep -qE '^[[:space:]]*(export[[:space:]]+)?CLICKUP_API_TOKEN=.' "$cu_cfg" 2>/dev/null; then
    pass "tracker: clickup, token found (test it: gsd-tracker check)"
  else
    fail "tracker = clickup but no ClickUp token on this machine — tickets will not move" "put CLICKUP_API_TOKEN=pk_… in $cu_cfg (ClickUp → Settings → Apps)" "T073"
  fi
  command -v jq >/dev/null 2>&1 || note "tracker = clickup needs jq for start/finish/snapshot — brew install jq"
else
  # Old phases tagged cu_<id> were written for ClickUp write-back; with the
  # default tracker = none those tickets would silently stop moving.
  if grep -qiE '^#{2,4} Phase [0-9.]+:.*(^|[^a-z0-9])cu[-_][a-z0-9]{6,}' "$MAIN/.planning/ROADMAP.md" 2>/dev/null; then
    fail "ROADMAP has ClickUp-tagged phases (cu_<id>) but tracker = none — their tickets are not updated" "add 'tracker = clickup' to .gsd.conf" "T070"
  fi
fi

drift=0
missing=0
while IFS= read -r rel; do
  [ -n "$rel" ] || continue
  if [ ! -f "$MAIN/$rel" ]; then missing=$((missing + 1))
  elif ! cmp -s "$GSD_PKG/shims/$rel" "$MAIN/$rel"; then drift=$((drift + 1)); fi
done < <( cd "$GSD_PKG/shims" && find scripts -type f -name 'gsd-*' ! -name '*.example' 2>/dev/null )
if [ "$missing" -gt 0 ] || [ "$drift" -gt 0 ]; then
  fail "shims: $missing missing, $drift out of date" "gsd-init" "T010"
else
  pass "shims present and current"
fi

# The three merge-safety items, from the same predicate gsd-bootstrap-repo
# applies — one source of truth for what "installed" means.
gsd_planning_status "$MAIN"
case " $GSD_PLANNING_MISSING " in
  *" attributes "*)
    [ "$GSD_ATTRS_STATE" = union ] \
      && fail ".gitattributes still on merge=union (keeps BOTH sides)" "gsd-init" "T011" \
      || fail ".gitattributes missing the .planning merge rules" "gsd-init" "T012" ;;
  *) pass ".gitattributes: merge=gsd-planning on ROADMAP.md + STATE.md" ;;
esac
case " $GSD_PLANNING_MISSING " in
  # Not versioned, so a fresh clone always lacks it. gsd-finish re-asserts it,
  # so this is a finding rather than an emergency.
  *" driver "*) fail "merge driver not registered (per-clone; git config is not versioned)" "gsd-init" "T013" ;;
  *) pass "merge driver registered in git config" ;;
esac
case " $GSD_PLANNING_MISSING " in
  *" hook "*) fail "no post-merge hook — a plain 'git pull' is unguarded" "gsd-init" "T014" ;;
  *) pass "post-merge hook reconciles .planning after a plain git pull" ;;
esac
# A .husky/ dir alone counts as "husky owns the hook", but git only runs it
# when core.hooksPath points there (husky sets that on npm install).
if [ -d "$MAIN/.husky" ]; then
  case "$(git -C "$MAIN" config --get core.hooksPath 2>/dev/null)" in
    *.husky*) ;;
    *) note ".husky/ exists but core.hooksPath does not point into it — git will not run .husky/post-merge until husky is installed (npm install)" ;;
  esac
fi

fi  # IS_GSD_REPO

# ── planning state (fixed by gsd-planning-repair) ────────────────────────────
if [ "$IS_GSD_REPO" = 1 ]; then
section "planning state"

if [ ! -d "$MAIN/.planning" ]; then
  note "no .planning/ — this repo has no GSD planning state yet"
elif [ -d "$MAIN/.planning/workstreams" ] && [ -n "$(ls -A "$MAIN/.planning/workstreams" 2>/dev/null)" ]; then
  # gsd-core's /gsd-workstreams routes ROADMAP/STATE under
  # .planning/workstreams/<name>/. Every command in this toolkit reads the
  # top-level .planning/ROADMAP.md, so gsd-start/gsd-list/gsd-planning-repair
  # would silently claim, list and repair the wrong roadmap. Loud, not quiet.
  fail "gsd-core workstreams in use (.planning/workstreams/) — this toolkit only reads the top-level .planning/ and is not workstream-aware" \
       "/gsd-workstreams complete <name>, or drive those phases without gsd-start" "T024"
elif ! command -v gsd-planning-repair >/dev/null 2>&1; then
  fail "gsd-planning-repair not on PATH — cannot check .planning" "$REINSTALL" "T004"
else
  out="$(gsd-planning-repair --repo "$MAIN" --check 2>&1)"; rc=$?
  case "$rc" in
    0) pass ".planning is coherent"
       printf '%s\n' "$out" | grep -E '^  - ' | while IFS= read -r l; do note "${l#  - }"; done ;;
    1) fail ".planning contradicts itself (union-merge damage)" "gsd-planning-repair" "T020"
       printf '%s\n' "$out" | grep -E '^  • ' | sed 's/^  •/      ·/' ;;
    *) note ".planning has no ROADMAP.md — nothing to check" ;;
  esac
fi

# Phase-checkbox bookkeeping. Upstream's phase.insert skips the checklist and
# Progress rows, and phase.complete's tick regex is greedy — both fail without
# saying so, which is exactly why this belongs in a health check. See
# lib/roadmap-audit.pl for the mechanics.
# Scoped to the checkout you are STANDING IN, not $MAIN — unlike every other
# check here. Each worktree carries its own .planning/ROADMAP.md (its branch's
# version), and the branch is where phase.complete will actually run. Auditing
# $MAIN from inside a worktree reports the phase's roadmap clean while the
# branch's own copy is broken, which is worse than not checking at all.
HERE="$(git -C "$REPO" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$MAIN")"
[ -f "$HERE/.planning/ROADMAP.md" ] || HERE="$MAIN"
ROADMAP="$HERE/.planning/ROADMAP.md"

# The branch is named ONCE, above the findings — repeating it on every line is
# the same right-edge noise the fix-summary avoids.
BR=""; EDIT="edit .planning/ROADMAP.md"
if [ "$HERE" != "$MAIN" ]; then
  BR="$(git -C "$HERE" branch --show-current 2>/dev/null)"
  BR="${BR:-$(basename "$HERE")}"
  EDIT="edit .planning/ROADMAP.md in $(basename "$HERE")"
fi

# Two headings with one phase number (a bad merge, a hand edit): claims,
# finishes and ticks then hit whichever comes first. 07 and 7 are the same.
if [ -f "$ROADMAP" ]; then
  dups=$(sed -nE 's/^#{2,4} Phase ([0-9]+(\.[0-9]+)?):.*/\1/p' "$ROADMAP" \
         | awk -F. '{ n = $1 + 0; if (NF > 1) n = n "." ($2 + 0); print n }' | sort | uniq -d | tr '\n' ' ')
  [ -z "$dups" ] || fail "ROADMAP has more than one heading for phase(s): ${dups% }" "$EDIT (one '### Phase N:' heading per number)" "T025"
fi

if [ -f "$ROADMAP" ] && ! command -v perl >/dev/null 2>&1; then
  note "roadmap row check skipped — needs perl (see T006)"
elif [ -f "$ROADMAP" ] && [ -f "$GSD_PKG/lib/roadmap-audit.pl" ]; then
  audit="$(perl "$GSD_PKG/lib/roadmap-audit.pl" "$ROADMAP" 2>/dev/null)"
  [ -z "$BR" ] || note "roadmap checked on '$BR' (this worktree's own copy, not $(gsd_base "$MAIN")'s)"
  if [ -z "$audit" ]; then
    pass "roadmap: every phase has its rows and ticks its own checkbox"
  else
    while IFS='|' read -r kind a b; do
      [ -n "$kind" ] || continue
      case "$kind" in
        TICK)   fail "completing Phase $a would tick the wrong row: $b" "$EDIT" "T021" ;;
        NOROW)  fail "Phase $a has no checklist row — completing it ticks nothing, silently" "$EDIT" "T022" ;;
        NOPROG) fail "Phase $a is missing from the Progress table" "$EDIT" "T023" ;;
      esac
    done <<EOF
$audit
EOF
    note "cross-references in a checklist row must read 'phase-13', never 'Phase 13'"
    [ -z "$BR" ] || note "these may all clear with:  git merge $(gsd_base "$MAIN")"
  fi
fi
# ── phase flow (opt-in: flow = strict) ──────────────────────────────────────
# Which MERGED phases skipped a mandatory step. Same artifact list the guard's
# flow rule and a repo's pre-merge gate enforce going forward; this is the
# backlog view over phases finished before those gates existed. Scoped to
# $MAIN (merged = on the base branch). `flow_since = <N>` in .gsd.conf limits
# it to phases >= N — older phases predate the rules and would only be noise.
if [ "$(gsd_conf_get "$MAIN" flow)" = "strict" ] && [ -f "$MAIN/.planning/ROADMAP.md" ]; then
  section "phase flow (flow = strict)"
  SINCE="$(gsd_conf_get "$MAIN" flow_since)"; SINCE="${SINCE:-0}"
  flow_has() { [ -f "$pd/$p-$1" ]; }
  debt=0; checked=0
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    awk -v a="$n" -v b="$SINCE" 'BEGIN{exit !(a+0 >= b+0)}' || continue
    case "$n" in *.*) p="$n" ;; *) p=$(printf '%02d' "$n") ;; esac
    pd=""; for d in "$MAIN/.planning/phases/$p"-*; do [ -d "$d" ] && { pd="$d"; break; }; done
    [ -n "$pd" ] || { note "Phase $n: no .planning/phases/$p-* directory (archived?) — skipped"; continue; }
    checked=$((checked + 1)); miss=""; fix=""
    # Only steps that still have an action AFTER the merge. Discuss and the
    # cross-AI plan review shape the plan; redoing them on built code changes
    # nothing (plan-phase --reviews refuses closed phases). The guard and the
    # pre-merge gate hold those going forward.
    if [ "$TRACKER" != none ] && ! flow_has TICKET.md && ! flow_has STORY.md; then
      case "$pd" in *cu_*) ;; *)
        tk=$(gsd_ticket_extract "$(basename "$pd")")
        miss="$miss ticket"; fix="$fix gsd-tracker snapshot ${tk:-<id>} --out ${pd#"$MAIN"/}/$p-TICKET.md;" ;;
      esac
    fi
    flow_has REVIEW.md       || { miss="$miss code-review";     fix="$fix /gsd-code-review $n;"; }
    if flow_has SECURITY.md; then
      open=$(sed -n '/^---$/,/^---$/p' "$pd/$p-SECURITY.md" | sed -n 's/^threats_open:[[:space:]]*//p' | head -1 | tr -d '[:space:]')
      [ "${open:-0}" = 0 ] || { miss="$miss security($open-open)"; fix="$fix /gsd-secure-phase $n;"; }
    else miss="$miss secure-phase"; fix="$fix /gsd-secure-phase $n;"; fi
    flow_has VERIFICATION.md || { miss="$miss verifier";        fix="$fix /gsd-execute-phase $n (runs the verifier);"; }
    ls "$pd/$p"-*UAT.md >/dev/null 2>&1 || { miss="$miss verify-work"; fix="$fix /gsd-verify-work $n;"; }
    if flow_has UI-SPEC.md && ! flow_has UI-REVIEW.md; then miss="$miss ui-review"; fix="$fix /gsd-ui-review $n;"; fi
    if [ -n "$miss" ]; then
      debt=$((debt + 1))
      fail "Phase $n merged without:$miss" "in a phase-$n worktree:${fix%;}" "T040"
    fi
  done < <(sed -n -E 's/^- \[x\] \*\*Phase ([0-9]+(\.[0-9]+)?):.*/\1/p' "$MAIN/.planning/ROADMAP.md")
  [ "$debt" -eq 0 ] && pass "every merged phase since $SINCE carries its mandatory artifacts ($checked checked)"
fi
fi  # IS_GSD_REPO

# ── worktree hygiene ─────────────────────────────────────────────────────────
# Worth checking anywhere: stale locks and orphaned phase branches are about
# git state, not about whether the repo opted into GSD.
section "worktrees"

LOCK="$MAIN/.git/gsd-cmd.lock"
if [ -d "$LOCK" ]; then
  pid="$(cat "$LOCK/pid" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    note "a gsd command is running right now (pid $pid)"
  else
    fail "stale command lock from a crashed run (pid ${pid:-?})" "rm -rf .git/gsd-cmd.lock" "T030"
  fi
fi

gone=0
live_branches=""
while IFS= read -r line; do
  case "$line" in
    "worktree "*) wt="${line#worktree }"; [ -d "$wt" ] || gone=$((gone + 1)) ;;
    "branch "*)   live_branches="$live_branches ${line#branch refs/heads/}" ;;
  esac
done < <(git -C "$MAIN" worktree list --porcelain 2>/dev/null)
# A worktree whose dependency install failed: /gsd-execute-phase is blocked
# there (guard rule 3) until the install is fixed.
while IFS= read -r line; do
  case "$line" in "worktree "*) ;; *) continue ;; esac
  wt="${line#worktree }"
  [ "$wt" != "$MAIN" ] && [ -f "$wt/.gsd-install.status" ] || continue
  case "$(tr -d '[:space:]' < "$wt/.gsd-install.status")" in
    fail) fail "dependency install failed in $(basename "$wt") — execute-phase is blocked there" "read $wt/.gsd-install.log, fix, then re-run the install in that worktree" "T032" ;;
    running) note "dependency install still running in $(basename "$wt")" ;;
  esac
done < <(git -C "$MAIN" worktree list --porcelain 2>/dev/null)

[ "$gone" -gt 0 ] \
  && fail "$gone worktree(s) recorded but missing on disk" "git worktree prune" "W027" \
  || pass "no stale worktree records"

orphans=""
while IFS= read -r br; do
  [ -n "$br" ] || continue
  case " $live_branches " in *" $br "*) continue ;; esac
  orphans="$orphans $br"
done < <(git -C "$MAIN" for-each-ref --format='%(refname:short)' 'refs/heads/phase-*' 2>/dev/null)
if [ -n "$orphans" ]; then
  fail "phase branch(es) with no worktree:$orphans" "gsd-finish <N>, or git branch -d" "W017"
else
  pass "every phase branch has its worktree"
fi

# Branches whose upstream was deleted (a merged PR, a gsd-finish run from
# another machine). Read from the last fetch — no fetch here, by design.
gone_up=$(git -C "$MAIN" for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads 2>/dev/null \
            | awk '$2=="[gone]"{print $1}' | tr '\n' ' ')
[ -z "$gone_up" ] || note "branch(es) whose upstream is gone: ${gone_up}— git fetch --prune && git branch -d <name>"

BASE="$(gsd_base "$MAIN")"
cur="$(git -C "$MAIN" branch --show-current 2>/dev/null)"
[ "$cur" = "$BASE" ] \
  && pass "main checkout is on '$BASE'" \
  || fail "main checkout is on '$cur', not '$BASE' (gsd-finish will refuse)" "git checkout $BASE" "T031"

if git -C "$MAIN" show-ref --verify --quiet "refs/remotes/origin/$BASE"; then
  behind=$(git -C "$MAIN" rev-list --count "$BASE..origin/$BASE" 2>/dev/null || echo 0)
  [ "${behind:-0}" -gt 0 ] \
    && note "'$BASE' is $behind commit(s) behind origin as of your last fetch (no fetch is done here)"
fi

# ── verdict ──────────────────────────────────────────────────────────────────
if [ "$JSON" = 1 ]; then
  instruction_file=$(gsd_provider_instruction_file "$DOCTOR_PROVIDER" 2>/dev/null || echo '')
  instruction_integrated=false; gsd_provider_instruction_integrated "$MAIN" "$DOCTOR_PROVIDER" && instruction_integrated=true
  skill_installed=false; doctor_skillroot=$(gsd_provider_skill_root "$DOCTOR_PROVIDER" 2>/dev/null || true); [ -n "$doctor_skillroot" ] && [ -f "$doctor_skillroot/gsd-flow/SKILL.md" ] && skill_installed=true
  native_hook=$(gsd_provider_hook_state "$MAIN" "$DOCTOR_PROVIDER")
  command_guard=false; gsd_command_guards_active "$GSD_PKG" && command_guard=true
  configured_json=""; doctor_configured=$(gsd_conf_get "$MAIN" providers); doctor_configured=${doctor_configured:-$DOCTOR_PROVIDER}; oldifs=$IFS; IFS=,; for p in $doctor_configured; do configured_json="${configured_json:+$configured_json,}\"$(jstr "$p")\""; done; IFS=$oldifs
  printf '{"session_model":"%s",' "$(jstr "$DOCTOR_MODEL")"
  # false = not a GSD repo: its setup/planning checks were skipped, so a zero
  # count means "nothing to check", not "healthy".
  printf '"gsd_repo":%s,' "$([ "$IS_GSD_REPO" = 1 ] && echo true || echo false)"
  printf '"repo":"%s","configured":[%s],"provider":{"name":"%s","command":"%s","available":%s,"instruction_file":"%s","instruction_integrated":%s,"skill_installed":%s,"command_guard":%s,"native_hook":"%s"},"count":%d,"findings":[%s],"updates":[%s]}\n' "$(jstr "$MAIN")" "$configured_json" "$(jstr "$DOCTOR_PROVIDER")" "$(jstr "$DOCTOR_COMMAND")" "$PROVIDER_AVAILABLE" "$(jstr "$instruction_file")" "$instruction_integrated" "$skill_installed" "$command_guard" "$native_hook" "$FINDINGS" "$JSON_ITEMS" "$UPDATES_JSON"
  [ "$FINDINGS" -eq 0 ]; exit $?
fi
echo ""
if [ "$FINDINGS" -eq 0 ]; then
  printf '\033[32m✔ no findings\033[0m\n'
  exit 0
fi
printf '\033[31m%d finding(s).\033[0m Run:\n\n' "$FINDINGS"
[ "$(git rev-parse --show-toplevel 2>/dev/null)" = "$MAIN" ] || printf '  cd %s\n' "$MAIN"
printf '%s\n' "$FIXES" | while IFS= read -r fix; do printf '  %s\n' "$fix"; done
echo ""
echo "(then re-run gsd-doctor to confirm)"
exit 1
