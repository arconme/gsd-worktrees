#!/usr/bin/env bash
set -euo pipefail
die() { printf '✖ %s\n' "$*" >&2; exit 1; }
usage() { cat <<'HELP'
gsd-bootstrap-repo — install GSD worktree integration into the current repo
USAGE
  gsd-bootstrap-repo [--agent claude|codex]... [options]
OPTIONS
  --agent <provider>       provider to integrate; repeat for multiple providers
  --agents <a,b,...>       comma-separated provider list
  --agent-command <path>   executable override for the default provider
  --provider-command <p=path> executable override for one provider; repeatable
  --base <branch>          base branch (auto-detected by default)
  --commit                 commit only the installed integration files
  --no-ui                  no screens in this project: ui_gates = off
  --tracker <t>            ticket tracker: none, clickup or custom (tracker = in .gsd.conf)
  --tracker-command <path> with --tracker custom: the repo's tracker script
  --src <path>             deprecated; ignored
  -h, --help               show help
HELP
}
TRACKER=""; TRACKER_COMMAND=""
BASE=""; BASE_EXPLICIT=0; COMMIT=0; NO_UI=0; AGENT_COMMAND=""; SELECTED=""
COMMAND_PROVIDERS=""
CLAUDE_COMMAND=""; CODEX_COMMAND=""; CUSTOM_COMMAND=""
add_provider() { local p=$1; case "$p" in claude|codex|custom) ;; gemini) die "Gemini is no longer supported (gsd-core, the new GSD, dropped it); use claude, codex, or custom" ;; *) die "unknown provider '$p' (expected claude, codex, or custom)" ;; esac; case ",$SELECTED," in *",$p,"*) ;; *) SELECTED="${SELECTED:+$SELECTED,}$p" ;; esac; }
set_provider_command() { local p=$1 c=$2; case "$c" in *[[:space:]]*) die "provider command must be one executable path/name" ;; esac; case "$p" in claude) CLAUDE_COMMAND=$c ;; codex) CODEX_COMMAND=$c ;; custom) CUSTOM_COMMAND=$c ;; *) die "unknown provider '$p'" ;; esac; }
provider_command() { case "$1" in claude) printf '%s' "$CLAUDE_COMMAND" ;; codex) printf '%s' "$CODEX_COMMAND" ;; custom) printf '%s' "$CUSTOM_COMMAND" ;; esac; }
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --base) [ $# -ge 2 ] || die "--base needs a value"; BASE=$2; BASE_EXPLICIT=1; shift 2 ;;
    --agent) [ $# -ge 2 ] || die "--agent needs a provider"; add_provider "$2"; shift 2 ;;
    --agents) [ $# -ge 2 ] || die "--agents needs a comma-separated list"; case "$2" in ,*|*,|*,,*) die "malformed --agents list: $2" ;; esac; oldifs=$IFS; IFS=,; for p in $2; do add_provider "$p"; done; IFS=$oldifs; shift 2 ;;
    --agent-command) [ $# -ge 2 ] || die "--agent-command needs one executable path/name"; AGENT_COMMAND=$2; shift 2 ;;
    --provider-command) [ $# -ge 2 ] || die "--provider-command needs provider=executable"; case "$2" in *=*) pc_p=${2%%=*}; pc_c=${2#*=}; [ -n "$pc_p" ] && [ -n "$pc_c" ] || die "malformed --provider-command: $2"; set_provider_command "$pc_p" "$pc_c"; case ",$COMMAND_PROVIDERS," in *",$pc_p,"*) ;; *) COMMAND_PROVIDERS="${COMMAND_PROVIDERS:+$COMMAND_PROVIDERS,}$pc_p" ;; esac ;; *) die "--provider-command needs provider=executable" ;; esac; shift 2 ;;
    --commit) COMMIT=1; shift ;;
    --no-ui) NO_UI=1; shift ;;
    --tracker) [ $# -ge 2 ] || die "--tracker needs none, clickup or custom"; TRACKER=$2; shift 2 ;;
    --tracker-command) [ $# -ge 2 ] && [ -n "$2" ] || die "--tracker-command needs the script's path"; TRACKER_COMMAND=$2; shift 2 ;;
    --src) [ $# -ge 2 ] || die "--src needs a value"; echo "• --src is deprecated and ignored"; shift 2 ;;
    *) die "unknown arg: $1 (see gsd-bootstrap-repo --help)" ;;
  esac
done
SELF=$0; while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
PKG=$(cd "$(dirname "$SELF")/.." && pwd); . "$PKG/lib/common.sh"; . "$PKG/lib/provider.sh"
# shellcheck source=../lib/ui.sh
. "$PKG/lib/ui.sh"
DEST=$(git rev-parse --show-toplevel 2>/dev/null) || die "run this from inside the target git repo"
case "$TRACKER" in ''|none|clickup|custom) ;; *) die "unknown tracker '$TRACKER' (expected none, clickup or custom)" ;; esac
[ -z "$TRACKER_COMMAND" ] || [ "$TRACKER" = custom ] || die "--tracker-command goes with --tracker custom"
case "$TRACKER_COMMAND" in *[[:space:]]*) die "--tracker-command must be one path, not a command line" ;; esac
if [ "$TRACKER" = custom ] && [ -z "$TRACKER_COMMAND" ] && [ -z "$(gsd_conf_get "$DEST" tracker_command)" ]; then
  die "--tracker custom needs --tracker-command <script> (e.g. scripts/tracker.sh)"
fi
[ "$DEST" != "$PKG" ] || die "you're inside the toolkit repo itself — cd into the target repo first"
DIRTY_BEFORE=$(git -C "$DEST" status --porcelain)
CONF=$DEST/.gsd.conf
# Gemini was a provider until 0.5.0: an older repo's list loses it here, and
# drop_gemini (below) removes what we wrote for it.
GEMINI_DROPPED=0
case ",$(gsd_conf_get "$DEST" providers),$(gsd_conf_get "$DEST" provider)," in *,gemini,*) GEMINI_DROPPED=1 ;; esac
drop_gone() {  # $1=provider list → the list without gemini (claude if that was all)
  case ",$1," in *,gemini,*) ;; *) printf '%s' "$1"; return ;; esac
  local l; l=$(printf ',%s,' "$1" | sed -e 's/,gemini,/,/g' -e 's/^,//' -e 's/,$//')
  printf '%s' "${l:-claude}"
}
OLD_PROVIDERS=$(drop_gone "$(gsd_conf_get "$DEST" providers)")
if [ -z "$SELECTED" ] && grep -qE '^[[:space:]]*providers[[:space:]]*=' "$CONF" 2>/dev/null; then
  gsd_provider_list_validate "$OLD_PROVIDERS" || exit $?
fi
[ -n "$OLD_PROVIDERS" ] || OLD_PROVIDERS=$(drop_gone "$(gsd_conf_get "$DEST" provider)")
OLD_DEFAULT=${OLD_PROVIDERS%%,*}; OLD_DEFAULT=${OLD_DEFAULT:-claude}
if [ -z "$SELECTED" ]; then SELECTED=${OLD_PROVIDERS:-${COMMAND_PROVIDERS:-${GSD_PROVIDER:-${GSD_AGENT:-claude}}}}; fi
gsd_provider_list_validate "$SELECTED" || exit $?
oldifs=$IFS; IFS=,; CHECKED=""; for p in $SELECTED; do add_provider "$p"; CHECKED="${CHECKED:+$CHECKED,}$p"; done; IFS=$oldifs; SELECTED=$CHECKED
DEFAULT=${SELECTED%%,*}
oldifs=$IFS; IFS=,; for p in $COMMAND_PROVIDERS; do
  case ",$SELECTED," in *",$p,"*) ;; *) die "command override for '$p' is outside providers '$SELECTED'; select integrations with --agents" ;; esac
done; IFS=$oldifs
# Keep the old generic executable bound to its original provider on migration.
# Explicit overrides win; existing provider-specific keys already have priority.
# A legacy agent_command that ran Gemini goes with it: never bind it to the
# provider that took Gemini's place.
OLD_COMMAND=$(gsd_conf_get "$DEST" agent_command)
RAW_OLD_DEFAULT=$(gsd_conf_get "$DEST" providers); RAW_OLD_DEFAULT=${RAW_OLD_DEFAULT:-$(gsd_conf_get "$DEST" provider)}; RAW_OLD_DEFAULT=$(printf '%s' "$RAW_OLD_DEFAULT" | tr -d '[:space:]')
[ "${RAW_OLD_DEFAULT%%,*}" != gemini ] || OLD_COMMAND=""
if [ -n "$OLD_COMMAND" ] && [ -z "$(provider_command "$OLD_DEFAULT")" ] && [ -z "$(gsd_conf_get "$DEST" "${OLD_DEFAULT}_command")" ]; then
  gsd_provider_validate "$OLD_DEFAULT" "$OLD_COMMAND" || exit $?
  set_provider_command "$OLD_DEFAULT" "$OLD_COMMAND"
fi
[ -z "$AGENT_COMMAND" ] || set_provider_command "$DEFAULT" "$AGENT_COMMAND"
oldifs=$IFS; IFS=,; for p in $SELECTED; do
  effective_command=$(provider_command "$p")
  [ -n "$effective_command" ] || effective_command=$(gsd_conf_get "$DEST" "${p}_command")
  gsd_provider_validate "$p" "$effective_command" || exit $?
done; IFS=$oldifs
# Reject ambiguous ownership before changing any repository file. An unmatched,
# nested, inline, reversed, or duplicate marker must never eat user content.
oldifs=$IFS; IFS=,; for p in $SELECTED; do
  instruction_file="$DEST/$(gsd_provider_instruction_file "$p")"
  [ -f "$instruction_file" ] || continue
  gsd_owned_markers_valid "$instruction_file" provider || die "ambiguous GSD markers in $instruction_file; repair the start/end pair manually (all files preserved)"
done; IFS=$oldifs
gsd_owned_markers_valid "$DEST/.gsd/INSTRUCTIONS.md" canonical || die 'ambiguous canonical GSD markers; repair the start/end pair (all files preserved)'
if [ -z "$BASE" ]; then BASE=$(gsd_base "$DEST"); fi
[ -n "$BASE" ] || die "could not determine base branch — pass --base <branch>"
[ "$BASE_EXPLICIT" = 0 ] || git -C "$DEST" show-ref --verify --quiet "refs/heads/$BASE" || die "branch '$BASE' does not exist"
WT_DIR=$(gsd_wtdir "$DEST")
if [ -f "$DEST/pnpm-lock.yaml" ]; then PM="pnpm install"; elif [ -f "$DEST/yarn.lock" ]; then PM="yarn install"; elif [ -f "$DEST/package-lock.json" ] || [ -f "$DEST/package.json" ]; then PM="npm install"; else PM=none; fi
printf 'Toolkit     : %s\nTarget repo : %s\nBase branch : %s\nProviders   : %s (default: %s)\n\n' "$PKG" "$DEST" "$BASE" "$SELECTED" "$DEFAULT"
if [ ! -f "$CONF" ]; then
    { echo '# .gsd.conf — committed, inspectable GSD worktree configuration.'; printf 'base = %s\nwtdir = %s\ninstall = %s\nproviders = %s\n' "$BASE" "$WT_DIR" "$PM" "$SELECTED"; [ -z "$CLAUDE_COMMAND" ] || printf 'claude_command = %s\n' "$CLAUDE_COMMAND"; [ -z "$CODEX_COMMAND" ] || printf 'codex_command = %s\n' "$CODEX_COMMAND"; [ -z "$CUSTOM_COMMAND" ] || printf 'custom_command = %s\n' "$CUSTOM_COMMAND"; echo '# start_mode = discuss  # optional; default is flow (gsd-start opens /gsdw-flow)'; echo '# flow = strict'; if [ "$NO_UI" = 1 ]; then echo 'ui_gates = off'; else echo '# ui_gates = strict  # UI gates: warn (default), strict, off'; fi; } > "$CONF"
  echo '✔ .gsd.conf (created)'
else
  update_key() { local k=$1 v=$2; K=$k V=$v perl -pi -e 's/^\s*\Q$ENV{K}\E\s*=.*/$ENV{K} = $ENV{V}/' "$CONF"; grep -qE "^[[:space:]]*${k}[[:space:]]*=" "$CONF" || printf '%s = %s\n' "$k" "$v" >> "$CONF"; }
  remove_key() { local k=$1; K=$k perl -ni -e 'print unless /^\s*\Q$ENV{K}\E\s*=/' "$CONF"; }
  update_key providers "$SELECTED"; remove_key provider; remove_key agent_command; [ -z "$CLAUDE_COMMAND" ] || update_key claude_command "$CLAUDE_COMMAND"; [ -z "$CODEX_COMMAND" ] || update_key codex_command "$CODEX_COMMAND"; remove_key gemini_command; remove_key gemini_model; [ -z "$CUSTOM_COMMAND" ] || update_key custom_command "$CUSTOM_COMMAND"; [ "$BASE_EXPLICIT" = 0 ] || update_key base "$BASE"; [ "$NO_UI" = 0 ] || update_key ui_gates off
  echo '✔ .gsd.conf (provider configuration updated; other keys preserved)'
fi
if [ -n "$TRACKER" ]; then
  set_key() { K=$1 V=$2 perl -pi -e 's/^\s*\Q$ENV{K}\E\s*=.*/$ENV{K} = $ENV{V}/' "$CONF"; grep -qE "^[[:space:]]*$1[[:space:]]*=" "$CONF" || printf '%s = %s\n' "$1" "$2" >> "$CONF"; }
  set_key tracker "$TRACKER"; [ -z "$TRACKER_COMMAND" ] || set_key tracker_command "$TRACKER_COMMAND"
  echo "✔ .gsd.conf: tracker = $TRACKER${TRACKER_COMMAND:+ ($TRACKER_COMMAND)}"
fi
mkdir -p "$DEST/scripts/hooks" "$DEST/.gsd"
for rel in scripts/gsd-new-worktree-feature.sh scripts/gsd-finish-worktree-feature.sh scripts/gsd-derive-port.sh scripts/gsd-planning-repair.sh scripts/hooks/gsd-worktree-guard.sh; do cp "$PKG/shims/$rel" "$DEST/$rel"; chmod +x "$DEST/$rel"; echo "✔ $rel (shim)"; done
for pat in .gsd-install.status .gsd-install.log .claude/settings.local.json; do
  grep -qxF "$pat" "$DEST/.gitignore" 2>/dev/null && continue
  # a .gitignore whose last line has no newline would glue our line onto it
  [ ! -s "$DEST/.gitignore" ] || [ -z "$(tail -c1 "$DEST/.gitignore")" ] || printf '\n' >> "$DEST/.gitignore"
  echo "$pat" >> "$DEST/.gitignore"
done
gsd_planning_apply "$DEST"
CANON=$DEST/.gsd/INSTRUCTIONS.md
if [ -f "$CANON" ] && grep -qx '<!-- gsd-worktrees:canonical -->' "$CANON"; then
  bak=$CANON.bak; n=1; while [ -e "$bak" ] || [ -L "$bak" ]; do bak=$CANON.bak.$n; n=$((n+1)); done
  cp "$CANON" "$bak"
  # Migrate the recognizable legacy generated span, retaining additions after it.
  perl -0777 -pi -e 's/^<!-- gsd-worktrees:canonical -->\n.*?^worktrees `[^\n]*`\.\n?//ms' "$CANON"
  echo "• legacy canonical content backed up to $bak"
fi
[ -f "$CANON" ] || touch "$CANON"
canonical_block=$(mktemp)
ui_on=on; [ "$(gsd_ui_gates "$DEST")" != off ] || ui_on=off
gsd_canonical_block "$SELECTED" "$DEFAULT" "$BASE" "$WT_DIR" "$ui_on" > "$canonical_block"
gsd_replace_owned_block "$CANON" canonical "$canonical_block"
rm -f "$canonical_block"
echo '✔ .gsd/INSTRUCTIONS.md (canonical workflow instructions)'
preserve_legacy_claude() {
  local file=$DEST/CLAUDE.md
  [ -f "$file" ] || return 0
  grep -q '^## GSD planning system' "$file" || return 0
  grep -q 'scripts/hooks/gsd-worktree-guard.sh' "$file" || return 0
  grep -q '<!-- gsd-worktrees:provider:start -->' "$file" && return 0
  echo '• preserved unmarked legacy GSD instructions in CLAUDE.md; the marked adapter will be appended'
}
update_entrypoint() {
  local file=$1 provider=$2 block; block=$(mktemp)
  gsd_provider_entry_block "$provider" > "$block"
  [ -f "$file" ] || touch "$file"
  gsd_replace_owned_block "$file" provider "$block"
  rm -f "$block"; echo "✔ ${file#"$DEST"/} ($provider entrypoint; unrelated content preserved)"
}
merge_hook() {
  local provider=$1 settings=$2 event=$3 matcher=$4 command=$5 tmp; mkdir -p "$(dirname "$settings")"; [ -f "$settings" ] || echo '{}' > "$settings"
  if [ "$(gsd_provider_hook_state "$DEST" "$provider")" = present ]; then echo "• ${settings#"$DEST"/} already registers the guard"; return; fi
  if ! command -v jq >/dev/null 2>&1 || ! jq empty "$settings" >/dev/null 2>&1; then echo "⚠ ${settings#"$DEST"/} is not mergeable JSON; preserved unchanged (native hook absent)"; return; fi
  if [ "$(gsd_provider_hook_state "$DEST" "$provider")" = invalid ]; then echo "⚠ incompatible hook structure in $settings; preserved unchanged"; return; fi
  # Do not override an explicit user decision to disable native hooks.
  if jq -e '.disableAllHooks == true or .hooksConfig.enabled == false' "$settings" >/dev/null; then echo "⚠ native hooks disabled in $settings; preserved unchanged"; return; fi
  tmp=$(mktemp)
  if ! jq --arg e "$event" --arg m "$matcher" --arg c "$command" '.hooks //= {} | .hooks[$e] = ((.hooks[$e] // []) + [{matcher:$m,hooks:[{type:"command",command:$c}]}])' "$settings" > "$tmp"; then rm -f "$tmp"; die "could not merge native hook into $settings (original preserved)"; fi
  mv "$tmp" "$settings"; echo "✔ ${settings#"$DEST"/} ($provider native guard hook)"
}
oldifs=$IFS; IFS=,
for p in $SELECTED; do
  [ "$p" != claude ] || preserve_legacy_claude
  members=""; entry=$(gsd_provider_instruction_file "$p")
  for member in $SELECTED; do [ "$(gsd_provider_instruction_file "$member")" != "$entry" ] || members="${members:+$members,}$member"; done
  update_entrypoint "$DEST/$entry" "$members"
  if gsd_provider_hook_metadata "$p"; then merge_hook "$p" "$DEST/$GSD_HOOK_SETTINGS" "$GSD_HOOK_EVENT" "$GSD_HOOK_MATCHER" "$GSD_HOOK_COMMAND"
  else echo "• $p native guard hook: unsupported; command-level guard remains active"; fi
done
IFS=$oldifs
# What an older release wrote for Gemini: the marked block in GEMINI.md (the
# file goes too when nothing else is left) and our hook in .gemini/settings.json.
# Text and settings of the user's own stay. A GEMINI.md that is a link (to
# AGENTS.md, say) is left alone: the block it shows is that file's.
GEMINI_FILES=()
drop_gemini() {
  local f=$DEST/GEMINI.md s=$DEST/.gemini/settings.json empty py
  if [ ! -L "$f" ] && [ -n "$(gsd_owned_block_get "$f" provider)" ] && gsd_owned_markers_valid "$f" provider; then
    empty=$(mktemp); gsd_replace_owned_block "$f" provider "$empty"; rm -f "$empty"
    perl -0777 -pi -e 's/\n+\z/\n/' "$f"
    if ! grep -q '[^[:space:]]' "$f"; then rm -f "$f"; echo '✔ GEMINI.md removed (only the gsd-worktrees block was in it; Gemini is no longer supported)'
    else echo '✔ GEMINI.md: the gsd-worktrees block removed (Gemini is no longer supported)'; fi
    GEMINI_FILES+=(GEMINI.md)
  fi
  [ -f "$s" ] && grep -q 'gsd-worktree-guard' "$s" || return 0
  py=$(gsd_python) || { echo "⚠ ${s#"$DEST"/} still has the gsd-worktrees hook (no Python to edit it)"; return 0; }
  # Any hook naming the guard is ours (doctor's T061 finds it by that name),
  # however its path was written and under whichever event.
  "$py" - "$s" <<'JSON' || { echo "⚠ ${s#"$DEST"/} still names gsd-worktree-guard — remove that hook by hand"; return 0; }
import json, os, sys
path = sys.argv[1]
try:
    data = json.load(open(path))
except ValueError:
    sys.exit(1)
if not isinstance(data, dict) or not isinstance(data.get("hooks"), dict):
    sys.exit(1)
ours = lambda h: isinstance(h, dict) and "gsd-worktree-guard" in str(h.get("command", ""))
found = False
for event, groups in list(data["hooks"].items()):
    if not isinstance(groups, list):
        continue
    kept = []
    for g in groups:
        if isinstance(g, dict) and isinstance(g.get("hooks"), list):
            rest = [h for h in g["hooks"] if not ours(h)]
            if len(rest) < len(g["hooks"]):
                found = True
                if not rest:
                    continue
            g["hooks"] = rest
        kept.append(g)
    if kept: data["hooks"][event] = kept
    else: del data["hooks"][event]
if not found:
    sys.exit(1)
if not data["hooks"]: del data["hooks"]
if data:
    with open(path, "w") as f:
        f.write(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
else:
    os.remove(path)
    try: os.rmdir(os.path.dirname(path))
    except OSError: pass
JSON
  echo '✔ .gemini/settings.json: the gsd-worktrees hook removed'
  GEMINI_FILES+=(.gemini/settings.json)
}
drop_gemini
[ "$GEMINI_DROPPED" = 0 ] || echo "✔ .gsd.conf: gemini removed from providers (Gemini is no longer supported)"
for f in "$DEST"/scripts/gsd-*.sh "$DEST"/scripts/hooks/gsd-worktree-guard.sh; do bash -n "$f"; done
echo '✔ self-check (shims parse)'
if [ "$COMMIT" = 1 ]; then
  if [ -n "$DIRTY_BEFORE" ]; then echo '⚠ target repo had existing changes — skipped --commit'; else
    files=(.gsd.conf .gsd/INSTRUCTIONS.md scripts .gitignore .gitattributes); oldifs=$IFS; IFS=,; for p in $SELECTED; do files+=("$(gsd_provider_instruction_file "$p")"); [ "$p" != claude ] || files+=(.claude/settings.json); done; IFS=$oldifs
    # a removed Gemini file is staged only if git tracked it (else git add dies)
    for f in ${GEMINI_FILES[@]+"${GEMINI_FILES[@]}"}; do
      [ -e "$DEST/$f" ] || git -C "$DEST" ls-files --error-unmatch -- "$f" >/dev/null 2>&1 && files+=("$f")
    done
    git -C "$DEST" add -- "${files[@]}"; gsd_planning_hook "$DEST"; [ "${GSD_HOOK_VERSIONED:-0}" = 1 ] && [ -f "$GSD_HOOK_PATH" ] && git -C "$DEST" add -- "$GSD_HOOK_PATH"; git -C "$DEST" diff --cached --quiet || git -C "$DEST" commit -q -m 'chore: add gsd-worktrees workflow'; echo '✔ bootstrap changes committed'
  fi
fi
echo; echo "✅ provider-neutral GSD workflow installed (default: $DEFAULT)"; echo "Next: gsd-init --no-launch (preserves $SELECTED), or gsd-start -n \"<desc>\""
