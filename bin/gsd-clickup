#!/usr/bin/env bash
#
# gsd-clickup — kept for old scripts: gsd-tracker with the ClickUp tracker.
#
#   gsd-clickup <command> …   ==   gsd-tracker --tracker clickup <command> …
#
# See gsd-tracker --help. New repos set `tracker = clickup` in .gsd.conf.
set -euo pipefail
SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
case "${1:-}" in
  -h|--help) awk 'NR>1 && /^set -euo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"; exit 0 ;;
esac
exec "$(dirname "$SELF")/gsd-tracker" --tracker clickup "$@"
